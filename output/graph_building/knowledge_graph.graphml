    <node id="N956249f3f0cab527">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">дифференциальная_термопара</data>
      <data key="d2">прибор для регистрации разности температур образца и эталона</data>
      <data key="d3" />
      <data key="d4">для предотвращения случайной погрешности при проведении сопоставительного эксперимента использовать один и те же регистрирующий прибор и термопару к ним</data>
    </node>
    <node id="Na9ec871f4328db99">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура начала превращения</data>
      <data key="d2">характеристика, определяющая момент начала фазового перехода</data>
      <data key="d3" />
      <data key="d4">точность ±278,15 K определять температура начало превращение аустенит-феррит, аустенит-перлит, аустенит-бейнит и аустенит-мартенсит</data>
    </node>
