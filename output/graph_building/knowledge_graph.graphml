      <data key="d6">2</data>
      <data key="d7">разность температура образец и эталон</data>
    </edge>
    <edge source="N5a79a1da14367eaa" target="Nf33920bc177c1c1d">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">точка на термокинетический кривая, в который начинаться отклонение от прямолинейный характер изменен</data>
    </edge>
    <edge source="Nd0e63d117f89e291" target="Naf1c78c91107a7e3">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
