    <edge source="N096bbf57b0199779" target="N9df3dc9fed6a5201">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">приводить при механический испытание растяжение к возникновение процесс микродеформация</data>
    </edge>
    <edge source="N1105da045cb0e1dd" target="Na2e20d13fef42324">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">повышение условный предел текучесть для сталь ферритно-бейнитный класс благодаря поглощение участок </data>
    </edge>
    <edge source="N1105da045cb0e1dd" target="Nf65de85fddf89731">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">наблюдаться снижение предел текучесть примерно на 15-20 kg/m/s**2 в результат проявление эффект Бауш</data>
    </edge>
    <edge source="N189893c061208bce" target="N43cc4213eac68d77">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">с выделение нитрид железо, что приводить к повышение твёрдость</data>
    </edge>
    <edge source="N581fa728e82fbc3a" target="N79bbf37a356faf7d">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">в опытный стать после окончательный прокатка с завершение деформация при температура 1013,15 K проис</data>
    </edge>
    <edge source="N581fa728e82fbc3a" target="Nbb269c9280800b3d">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Аустенитный зерно приобретать удлинённый вдоль направление деформация форма</data>
    </edge>
    <edge source="N4691c26f9bea8076" target="N0704ae246acee2d2">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">формировать конечный структура и механический свойство лист</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="N04863562625f2c41">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">что ухудшать вязкость и пластичность металл в результат твердорастворный упрочнение</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="N049f2a34fac3a3de">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">что обеспечивать повышение прочность и вязкость</data>
    </edge>
    <edge source="Nb10bd0769c46d67d" target="Nd3ef6865f764de7a">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">использовать для транспортировка газ</data>
    </edge>
    <edge source="Nb10bd0769c46d67d" target="Ncb050c9a79cae346">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">использовать для транспортировка газ</data>
    </edge>
    <edge source="Nb10bd0769c46d67d" target="N910998e18bcde6c4">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">разрушение газопровод происходить, как правило, при напряжение выше допустимый с точка зрение статич</data>
    </edge>
    <edge source="Nd3ef6865f764de7a" target="Ncb050c9a79cae346">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">использовать для транспортировка газ</data>
    </edge>
    <edge source="Nd3ef6865f764de7a" target="Ncf5ddebc7a4dc7c2">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">часть разрушение трубопровод при эксплуатация происходить из-за наличие дефект в область сварной сое</data>
    </edge>
    <edge source="Nd3ef6865f764de7a" target="N352b23fd48753398">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Причина разрушение мочь служить общий коррозия или стресс-коррозия под напряжение</data>
    </edge>
    <edge source="Naad1bb38d25547cd" target="N62baa9eb60231bb9">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">производительность газопровод прямо пропорциональный давление газ и возрастать в степень 2,6 s увели</data>
    </edge>
    <edge source="Naad1bb38d25547cd" target="N8d5305478ae6e564">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">производительность газопровод прямо пропорциональный давление газ</data>
    </edge>
    <edge source="Nfc39ad44fe1c0924" target="N1d55d9b910ffbf92">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Поэтому становиться целесообразный, в частность, использование стать категория прочность К65 (X80) в</data>
    </edge>
    <edge source="Nf28169bcff5741a8" target="Naf9fc5cc7aba98ba">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Трещина в металл трубопровод в зависимость от параметр эксплуатация мочь распространяться по вязкий,</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="N005948bb9758eaf0">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Возрастать предел текучесть на 80 и 100 H/mm²</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="N9cd566828b0c3acf">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">при понижение $T_{k*l}$ в однофазный аустенитный область (выше 1073,15 K) прочностный свойство измен</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="Nf65de85fddf89731">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">понижение вышеуказанный характеристика</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="Neb02ba881499b1ed">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">col_6: 0.866</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="N50d3075c28122aba">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">col_6: 0.866</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="Na8a839d01e6d22cb">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">+55</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="N892d387dddc0dd34">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">-18</data>
    </edge>
    <edge source="Ncb0798bbd8149ead" target="Nd45fe940fe243f31">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Если для стать 10Г2ФБ наблюдаться падение предел текучесть в результат трубный передел на 20-30 kg/m</data>
    </edge>
    <edge source="N59e37b8dd7c4bcd5" target="Na8a839d01e6d22cb">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">+23</data>
    </edge>
    <edge source="N59e37b8dd7c4bcd5" target="N892d387dddc0dd34">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">+14</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N7df96cd17b234d06">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">по сравнение со сталь 10Г2МФБ, из-за низкий содержание углерод, иметь хороший показатель свариваемос</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="Ncaa337138b4bd5eb">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Для описание влияние базовый химический состав стать на ее склонность к образование холодный трещина</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="Nccb5c2198e07f98b">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Для описание влияние базовый химический состав стать на ее склонность к образование холодный трещина</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N9722bd7d119a4e8c">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">Свариваемость во многое определяться химический состав и микроструктура сталь</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="Ne030a9a356762ee5">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Зависимость свариваемость сталь от химический состав основать на связь между склонность к образовани</data>
    </edge>
    <edge source="N2100c6994cf3b12e" target="Na75c5f3d8496e847">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">способствовать формирование игольчатый продукт распад аустенит взамен перлит</data>
    </edge>
    <edge source="N2100c6994cf3b12e" target="N3b9ccbadba40bfd9">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">В сравнительный стать 10Г2ФБ основный структурный составлять микроструктура являться полиэдрический </data>
    </edge>
    <edge source="N2100c6994cf3b12e" target="N37374cb8f316c7a7">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">превращение A→Ф, A→П и A→Б</data>
    </edge>
    <edge source="N2100c6994cf3b12e" target="Nef4aa77cfcea505a">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">превращение A → Б и A → М</data>
    </edge>
    <edge source="N0c64cfdc5636b465" target="N1a51539001f5bbb1">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Превращение аустенит в мартенсит наблюдаться в интервал температура 450-270 K</data>
    </edge>
    <edge source="N0c64cfdc5636b465" target="N00a165ead3916bf6">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">отмечаться рост ударный вязкость ОШЗ при весь температура испытание</data>
    </edge>
    <edge source="N0c64cfdc5636b465" target="Nef4aa77cfcea505a">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">состоять из смесь низкоуглеродистый бейнит и мартенсит реечный морфология</data>
    </edge>
    <edge source="Nb6b1061a942efb40" target="N86a14a4edf2ebcc9">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">Для эффективный глобуляризация сульфид содержание кальций в высокопрочный сталь обычно находиться в </data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N5130e9fdf5cffc99">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">игольчатый феррит, феррит</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N4f605111547a2bb9">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">бейнит иметь более высокий плотность дислокация по сравнение с феррит</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N749496fe0bb6a690">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">являться потенциальный место зарождение феррит</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N37374cb8f316c7a7">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Основный структурный составлять оставаться феррит и бейнит</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="Nef4aa77cfcea505a">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">полиморфный γ→α-превращение как в недеформированный, так и в деформировать образец</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N098660002759b88b">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">в деформировать образец измельчаться до 13-14 балл</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N4a336ebec4039cb2">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Увеличение скорость охлаждение образец вызывать повышение однородность конечный микроструктура</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N101365fc7fb6cf44">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">после нагрев в межкритический область при 1073,15 K структура оба сталь становиться двухфазный, сост</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="Na43d3f820c39f1e6">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">структура металл имитировать околошовный зона состоять из феррит и бейнит</data>
    </edge>
    <edge source="N3b9ccbadba40bfd9" target="N2392fa6a6fd8006b">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">фазовый наклёп феррит в область</data>
    </edge>
    <edge source="N86a14a4edf2ebcc9" target="N4e4d92e29b1bc585">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">при производство высокопрочный низколегированный штрипсовый сталь для улучшение их вязкость стремить</data>
    </edge>
    <edge source="N10eadd0d3ec6bbda" target="N35c35b613aabbe48">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">обратимый отпускной хрупкость можно рассматривать в качество один из причина межкристаллитный расщеп</data>
    </edge>
    <edge source="N10eadd0d3ec6bbda" target="Nec069b7c80aaa804">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">для это после завершение прокатка перед смотка полоса в рулон применяться высокий скорость охлаждени</data>
    </edge>
    <edge source="N10eadd0d3ec6bbda" target="N67b2adf7f60751b9">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">для это после завершение прокатка перед смотка полоса в рулон применяться высокий скорость охлаждени</data>
    </edge>
    <edge source="N10eadd0d3ec6bbda" target="Nebe3fa5306c723b0">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Проблема обратимый отпускной хрупкость в результат сегрегация фосфор мочь возникнуть</data>
    </edge>
    <edge source="N35c35b613aabbe48" target="N709a222a14dcc8f4">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">количество расщепление увеличиваться с понижение температура конец прокатка</data>
    </edge>
    <edge source="Naacdb7584f19dd62" target="N2a44355952c3a237">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">3</data>
      <data key="d7">размер атом ниобий на 15,6 % большой атом γ-железо. Это почти максимальный разница, при который возм</data>
    </edge>
    <edge source="Naacdb7584f19dd62" target="Nb788dd8292cc5545">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">3</data>
      <data key="d7">который окончательно подавлять рекристаллизация аустенит</data>
    </edge>
    <edge source="N005948bb9758eaf0" target="N2dc56ae4932b2c8e">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">что приводить к снижение количество дефект, обнаруживать при ультразвуковой контроль</data>
    </edge>
    <edge source="N005948bb9758eaf0" target="Neb02ba881499b1ed">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Возрастать предел текучесть на 80 и 100 H/mm² и временной сопротивление на 50 и 60 H/mm²</data>
    </edge>
    <edge source="N9f3f093fe9113f1b" target="Nee0591188383ca49">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">что естественно повышать содержание водород в стать благодаря реакция $Fe + H_2O = FeO + H_2$</data>
    </edge>
    <edge source="Nd601f0174de53798" target="Nc624181616be1579">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">При быстрый охлаждение твёрдый металл он оставаться в кристаллический решётка в состояние пересыщени</data>
    </edge>
    <edge source="Nb5eeabae54a00e30" target="N3299dcda41129dfd">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">При он содержание более 0,012 % часто наблюдать межкристаллитный разрушение в зона термический влиян</data>
    </edge>
    <edge source="Ned655cedb2c02153" target="N58640ed79856474c">
      <data key="d5">ТРЕБУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">При недостаточно отладить конверторный процесс, когда иметься утечка в система охлаждение</data>
    </edge>
    <edge source="N4f605111547a2bb9" target="N59b2429af749d2f0">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">торможение дислокация выделение частица избыточный фаза</data>
    </edge>
    <edge source="Nb158ff0d5cdcae83" target="N5a79a1da14367eaa">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Водородный охрупчивание наблюдаться в температурный интервал</data>
    </edge>
    <edge source="Nb158ff0d5cdcae83" target="N0084347f7e324835">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">уменьшаться с повышение скорость деформация</data>
    </edge>
    <edge source="N5a79a1da14367eaa" target="N098660002759b88b">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">строить кривая термический цикл и изменение деформация в зависимость от температура</data>
    </edge>
    <edge source="Nf059bb96c80bd984" target="Nad51497991e584de">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Обратимый водородный охрупчивание обусловить присутствие в стать диффузионно-подвижный водород</data>
    </edge>
    <edge source="Nf8ef008aadc92bc4" target="N3f392c0e65d80429">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Необратимый охрупчивание связать с образование дефект, в результат скопление молекулярный водород</data>
    </edge>
    <edge source="Nf8ef008aadc92bc4" target="N4c6c09649ccf61fb">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">В лист из непрерывнолить сляб для магистральный газопровод водородный охрупчивание проявляться в вид</data>
    </edge>
    <edge source="Nf8ef008aadc92bc4" target="N8e925584751a0b54">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">ультразвуковой контроль, который представлять себя микротрещина</data>
    </edge>
    <edge source="N3f392c0e65d80429" target="Nd02a907b08afb38e">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">переход водород в молекулярный форма сопровождаться возникновение большой внутренний давление, что п</data>
    </edge>
    <edge source="Ncc020193381684d8" target="N58480e3c116288fc">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">если это сопрячь с наличие ликвация и хрупкий структурный составлять, то мочь образовываться трещина</data>
    </edge>
    <edge source="N58480e3c116288fc" target="Nca8a25e8271aaecf">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">ликвационный неоднородность, вытянутый сульфид, высокоуглеродистый бейнитно-мартенситный структурный</data>
    </edge>
    <edge source="Nca8a25e8271aaecf" target="N127b526851edcb0b">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Ликвационный неоднородность, вытянутый сульфид, высокоуглеродистый бейнитно-мартенситный структурный</data>
    </edge>
    <edge source="N127b526851edcb0b" target="N55b85ada0122bf3e">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Ликвационный неоднородность, вытянутый сульфид, высокоуглеродистый бейнитно-мартенситный структурный</data>
    </edge>
    <edge source="N127b526851edcb0b" target="N153c5586ac299950">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Ликвационный неоднородность, вытянутый сульфид, высокоуглеродистый бейнитно-мартенситный структурный</data>
    </edge>
    <edge source="Nb351e40bc8216919" target="N05b4afd9cda3805f">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Одновременно с это происходить раскисление иметься в стать углерод (2C+O₂=2CO), а вакуум ускорять вы</data>
    </edge>
    <edge source="Nc23d2a1c677eb53f" target="N1266779230329775">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">повышать сплошность металл по результат ультразвуковой контроль</data>
    </edge>
    <edge source="N68f90570360d943f" target="Na0cf8cc57c207b0a">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">повышать сплошность металл по результат ультразвуковой контроль</data>
    </edge>
    <edge source="Nc2960ed3a3461787" target="N53cd96d37b301956">
      <data key="d5">ТРЕБУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">важный параметр являться толщина подкат для окончательный стадия прокатка</data>
    </edge>
    <edge source="Nc2960ed3a3461787" target="N96e6d437c793c318">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">завершение прокатка в двухфазный γ+α-область при температура 973,15 K</data>
    </edge>
    <edge source="Nc2960ed3a3461787" target="N9cd566828b0c3acf">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">окончание прокатка в аустенитный область при 1123,15 K</data>
    </edge>
    <edge source="Na94ab0fb79cd8a04" target="Naea38cd53af72e2d">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">разупрочнение аустенит вызываться только статический возврат, при который уменьшаться плотность дисл</data>
    </edge>
    <edge source="Na94ab0fb79cd8a04" target="N749496fe0bb6a690">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">разупрочнение горячедеформированный аустенит осуществляться за счёт протекание динамический и статич</data>
    </edge>
    <edge source="Na94ab0fb79cd8a04" target="Ne4c48fee582e3583">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">При это наблюдаться значительный измельчение аустенитный зерно (рис.3.1, г), по сравнение с зерно, о</data>
    </edge>
    <edge source="Nf353f54c4151a733" target="Nbbf051c4c017ad64">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">В микролегировать сталь всегда присутствовать углерод и азот, поэтому избыточный фаза ванадий, ниоби</data>
    </edge>
    <edge source="N0aa3f09e3efd6b3e" target="N2b0629116e2d6328">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">что объясняться отсутствие при этот температура выделение избыточный фаза ванадий</data>
    </edge>
    <edge source="Nb26feefd1de03933" target="N253da0697a02dddc">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Наличие дисперсный карбонитридный частица способствовать формирование более развитой субструктура</data>
    </edge>
    <edge source="Nef8462825dabde3a" target="N1fb2e03fd125ee2d">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Именно в это температурный интервал наблюдаться интенсивный торможение рекристаллизация горячедеформ</data>
    </edge>
    <edge source="N64ada51281a42ce6" target="N05d063761ae41761">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Размер рекристаллизовать зерно тем маленький, чем большой обжатие и ниже температура деформация</data>
    </edge>
    <edge source="N827aa29bcd819cbf" target="N3fc05ef5ffbb69ab">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Торможение рекристаллизация горячедеформированный аустенит при ТМКП способствовать измельчение конеч</data>
    </edge>
    <edge source="Ned629ab5cf758eac" target="N5130e9fdf5cffc99">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">Повышение устойчивость аустенит способствовать образование больший количество продукт низкотемперату</data>
    </edge>
    <edge source="N5130e9fdf5cffc99" target="Nf7212232f0fdefc4">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">продукт низкотемпературный превращение, такой, как игольчатый феррит</data>
    </edge>
    <edge source="Nc7c6588c1bc2e4bd" target="N0e7426ff62b6a3ca">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">вторичный выделение в α-фаза</data>
    </edge>
    <edge source="N0e7426ff62b6a3ca" target="N16a3b21b1a1a48db">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">метод рентгеновский дифрактометрия Определение фазовый состав проводить на рентгеновский дифрактомет</data>
    </edge>
    <edge source="N84a27b8c6d472581" target="N92d7bca0f9771ba2">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">нагрев заготовка под прокатка оказывать влияние на два основной характеристика аустенит: величина зе</data>
    </edge>
    <edge source="N92d7bca0f9771ba2" target="Nb7780f7808839f7f">
      <data key="d5">УСКОРЯЕТ</data>
      <data key="d6">2</data>
      <data key="d7">избыток свободный энергия система, который создавать движущий сила, необходимый для последующий рост</data>
    </edge>
    <edge source="N92d7bca0f9771ba2" target="Nbaced5aa0ff4f428">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">Для устранение экспоненциальный рост зерно аустенит при нагрев под прокатка, можно использовать дисп</data>
    </edge>
    <edge source="Na02ab491bf93d9f0" target="N56e4f50b7e9f7afa">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">присутствие труднорастворить частица второй фаза</data>
    </edge>
    <edge source="N6102f4424b98dfcf" target="N56e4f50b7e9f7afa">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">твердорастворный торможение</data>
    </edge>
    <edge source="N77fa353d5c829e98" target="N991e4e1ad062fbea">
      <data key="d5">УСКОРЯЕТ</data>
      <data key="d6">2</data>
      <data key="d7">В сталь с добавка сильный карбонитридообразовать элемент при аустенитизация мочь наблюдаться аномаль</data>
    </edge>
    <edge source="N4f6cbe2e02601aa4" target="N5b5c6b81b45f4c2e">
      <data key="d5">УСКОРЯЕТ</data>
      <data key="d6">3</data>
      <data key="d7">при температура нагрев 1150-1200 K зерно вырастать до очень больший размер</data>
    </edge>
    <edge source="N4f6cbe2e02601aa4" target="N1c2a5741139e393e">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">В простой низколегированный Si-Mn-сталях аномальный рост зерно не наблюдаться</data>
    </edge>
    <edge source="Ndb6833f7fc6a4b60" target="N5f4a843b2647a155">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Управление этот процесс на стадия предварительный прокатка металл приводить к эффективный измельчени</data>
    </edge>
    <edge source="N098660002759b88b" target="Nde4a9b6905c7869f">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">в результат это при горячий пластический деформация или во время междеформационный пауза мочь происх</data>
    </edge>
    <edge source="N098660002759b88b" target="Nd0de921c1906fd75">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">необходимый условие нагрев и деформация образец размер 10×8×0,006 m</data>
    </edge>
    <edge source="N098660002759b88b" target="N589b0df1d3591493">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">3</data>
      <data key="d7">во время деформация подстуживаться не более чем на 288,15 K за один проход</data>
    </edge>
    <edge source="N098660002759b88b" target="N79bbf37a356faf7d">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Видно, что окончательный прокатка в интервал температура отсутствие рекристаллизация не влиять на ра</data>
    </edge>
    <edge source="N098660002759b88b" target="Nbb269c9280800b3d">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Аустенитный зерно приобретать удлинённый вдоль направление деформация форма</data>
    </edge>
    <edge source="Naea38cd53af72e2d" target="N749496fe0bb6a690">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">разупрочнение горячедеформированный аустенит осуществляться за счёт протекание динамический и статич</data>
    </edge>
    <edge source="N749496fe0bb6a690" target="N01040bc2efef6ebc">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">фазовый превращение аустенит в основное металл</data>
    </edge>
    <edge source="N749496fe0bb6a690" target="Nf7ab45625502fa1f">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">завершать в двухфазный γ+α-область при температура 700-670 K</data>
    </edge>
    <edge source="N749496fe0bb6a690" target="N3a73da2402d9da14">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">В первый случай основной задача являться расширение область полный протекание рекристаллизация а</data>
    </edge>
    <edge source="N05d063761ae41761" target="N916b2db53ec5cb91">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Температура рекристаллизация горячедеформированный аустенит зависеть от параметр деформация и химиче</data>
    </edge>
    <edge source="N05d063761ae41761" target="N9640377df14a2694">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Размер рекристаллизовать зерно тем маленький, чем большой обжатие и ниже температура деформация</data>
    </edge>
    <edge source="N86e47e2ac57eeaa3" target="N4a336ebec4039cb2">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">После это образец охлаждать вместе с печь до температура ~1273,15 K и подвергать предварительный про</data>
    </edge>
    <edge source="N0a06e1b568f446b2" target="Nd589aeb564dd4d53">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">Для подавление собирательный рекристаллизация автор работа рекомендовать использовать ускоренный охл</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="N927d6daf9c994c0f">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">3</data>
      <data key="d7">Увеличение скорость охлаждение противодействовать образование вторичный ликвационный явление</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="N274ddf14dcadd26e">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Влияние скорость охлаждение на твёрдость (а), величина зерно (б) и количество структурный составлять</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="N3ce8b1c7655d3b60">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">образование практически полностью мартенситный структура при этот скорость охлаждение</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="N7f82fcb2ffccedba">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">увеличение доля бейнитный составлять формироваться в образец при непрерывный охлаждение</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="N0df29b072e34e103">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Влияние скорость охлаждение на твёрдость (а), величина зерно (б) и количество структурный составлять</data>
    </edge>
    <edge source="Na75c5f3d8496e847" target="Ne030a9a356762ee5">
      <data key="d5">УСКОРЯЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Изучать кинетика фазовый превращение аустенит в условие различный термический цикл сварка и связанны</data>
    </edge>
    <edge source="N37374cb8f316c7a7" target="Nef4aa77cfcea505a">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">превращение A → Б и A → М</data>
    </edge>
    <edge source="N37374cb8f316c7a7" target="N1d197390f39674fe">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">составлять мартенсит и бейнит</data>
    </edge>
    <edge source="N248d3c50ff1dc9b1" target="N7213a4635eaa5fb0">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">сформироваться в результат прошедшее в они процесс возврат и полигонизация</data>
    </edge>
    <edge source="N7e954f80c7dfb3e4" target="N7213a4635eaa5fb0">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">образоваться в результат γ→α-превращение без деформация</data>
    </edge>
    <edge source="N7662c24e82ce76f8" target="N0704ae246acee2d2">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">формировать конечный структура и механический свойство лист</data>
    </edge>
    <edge source="N39a3d75d20fde1c7" target="N6be413dc49b0b122">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">3</data>
      <data key="d7">определять физический предел текучесть, так как их диаграмма напряжение-деформация иметь выраженный </data>
    </edge>
    <edge source="N39a3d75d20fde1c7" target="N357b91205508b5db">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">полностью соответствовать требование Харцызский трубный завод для лист категория прочность К65</data>
    </edge>
    <edge source="Naaf5cb836f037ac4" target="Nffb4b4f81be61469">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">Требование к механический свойство основный металл труба категория прочность К65</data>
    </edge>
    <edge source="Nffb4b4f81be61469" target="Nf4b235644a67b9c7">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Трубный передел оказывать заметный влияние на механический свойство основный металл труба, особенно </data>
    </edge>
    <edge source="Nf119086c609aa7cd" target="N91bffa34027b2aac">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">Просвечивать электронный микроскопия Электронно-микроскопический исследование микроструктура листово</data>
    </edge>
    <edge source="N91bffa34027b2aac" target="Na4f26a4cc6750fe3">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Пластина сошлифовывать до толщина 0,15-0,2 m на тонкий абразивный бумага</data>
    </edge>
    <edge source="N91bffa34027b2aac" target="N9499feb524c31e8f">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Состав электролит: 0,00086 m**3 ортофосфорный кислота ( $H_{3}PO_{4}$ ), 100 г хромовый ангидрид</data>
    </edge>
    <edge source="N91bffa34027b2aac" target="N193eca8090889a6f">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Состав электролит: 0,00086 m**3 ортофосфорный кислота ( $H_{3}PO_{4}$ ), 100 г хромовый ангидрид</data>
    </edge>
    <edge source="Na4f26a4cc6750fe3" target="Nef57a10be610d028">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">утонять электролитический полировка до толщина 0,1-0,2 m в специальный пинцет с отверстие</data>
    </edge>
    <edge source="Nd0de921c1906fd75" target="N2efe55eb4473ce53">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">Имитация контролировать прокатка в лабораторный условие проводить после нагрев до температура 1423,1</data>
    </edge>
    <edge source="Na26768588d0d40e4" target="N8b2c75d1f5dd7cb9">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">2-х трубчатый микропечь 2, установленный непосредственно у прокатный валковый 1</data>
    </edge>
    <edge source="N733fc9d3199b5ba9" target="Nbcb570cd3bbdcfab">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">В качество эталон служить сталь 09X18H10T, который не испытывать фазовый превращение в исследовать и</data>
    </edge>
    <edge source="Nbcb570cd3bbdcfab" target="N229a60074f55b763">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">иметь теплоёмкость, близкий к теплоёмкость образец</data>
    </edge>
    <edge source="N0e6a6ff30795cbe7" target="Na56af3fde0fbed9b">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">Для зачеканка термопара в образец и эталон просверливать отверстие</data>
    </edge>
    <edge source="N0e6a6ff30795cbe7" target="N1c03cdd0d610bd2f">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">их спай помещать в этот отверстие посередине толщина</data>
    </edge>
    <edge source="Na56af3fde0fbed9b" target="N11188ef75be45f49">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">для зачеканка термопара в образец и эталон просверливать отверстие диаметр 0,0015 m</data>
    </edge>
    <edge source="Na56af3fde0fbed9b" target="N1c03cdd0d610bd2f">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">их спай помещать в этот отверстие посередине толщина и сплющивать середина отверстие</data>
    </edge>
    <edge source="N62932337157804e3" target="N22474afe3352002b">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">3</data>
      <data key="d7">с точность ±278,15 K определять температура начало превращение аустенит-феррит</data>
    </edge>
    <edge source="Nef4aa77cfcea505a" target="N7fd57944551a76fa">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">МА — мартенситно-аустенитный участок; М — мартенсит</data>
    </edge>
    <edge source="Nef4aa77cfcea505a" target="N459399fed2f3aeff">
