      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">наличие в структура лист из стать 05Г2МФБ в состояние после ТМКП больший количество (~15-20 %) проду</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Nb6d603947f80acf2">
