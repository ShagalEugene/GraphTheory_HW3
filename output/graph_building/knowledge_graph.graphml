      <data key="d3" />
      <data key="d4">что при их диаметр 0,06 m обеспечивать скорость деформация 15-20 с$^{-1}$</data>
    </node>
    <node id="N589b0df1d3591493">
      <data key="d0">ПАРАМЕТР</data>
