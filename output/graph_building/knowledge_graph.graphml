    <node id="N6740ed138d88ff0a">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">газопровод</data>
      <data key="d2">магистральный трубопровод для транспортировки природного газа</data>
      <data key="d3" />
      <data key="d4">В Россия запланировать строительство мощный магистральный газопровод, который соединить регион добыча природный газ</data>
    </node>
    <node id="N8631ff59f1c981f1">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">сталь К65</data>
      <data key="d2">материал для магистрального газопровода категории прочности К65</data>
      <data key="d3" />
      <data key="d4">Создание новый сталь для магистральны газопровод категория прочность К65</data>
    </node>
    <node id="Nec1f9fddfc510f91">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">сталь</data>
      <data key="d2">категория прочности К60 (X70) к категории прочности К65 (X80)</data>
      <data key="d3">X70; X80; К60; К65; сталь с дисперсный ферритно-бейнитный структура</data>
      <data key="d4">В работа использовать современный металлофизический метод исследование структура и фазовый состав металл с помощь оптический, просвечивать и растровый электронный микроскопия и рентгеновский дифрактометрия. Испытание механический свойство опытный сталь предусматривать оценка прочностный свойство и пластичность при статический растяжение, ударный вязкость, сопротивление хрупкий разрушение, измерение микротвёрдость структурный составлять.</data>
    </node>
    <node id="N2392fa6a6fd8006b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-перлитный</data>
      <data key="d2">структура, на базе которой невозможна высокая прочность</data>
      <data key="d3">ферритно-перлитный структура</data>
      <data key="d4">способствовать формирование в лист ферритно-бейнитный структура взамен ферритно-перлитный</data>
    </node>
    <node id="Na75248007f5d7f0d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">дисперсный ферритно-бейнитный</data>
      <data key="d2">иное структурное состояние материала для высокой прочности</data>
      <data key="d3">дисперсный ферритно-бейнитный структура</data>
      <data key="d4" />
    </node>
    <node id="Ne8990b213519fe31">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">C</data>
      <data key="d2">элемент, роль которого значительно снижается в подобной стали</data>
      <data key="d3">1,5-2 раз маленький содержание углерод</data>
      <data key="d4">как упрочнять элемент</data>
