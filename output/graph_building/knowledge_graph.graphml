      <data key="d3" />
      <data key="d4">во время деформация подстуживаться не более чем на 288,15 K за один проход</data>
    </node>
    <node id="N7998ba1e4b9919bc">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
