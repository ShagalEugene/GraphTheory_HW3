      <data key="d2">максимальное напряжение в процессе растяжения до разрушения</data>
      <data key="d3" />
      <data key="d4">Возрастать предел текучесть на 80 и 100 H/mm² и временной сопротивление на 50 и 60 H/mm²</data>
    </node>
    <node id="N9cd566828b0c3acf">
      <data key="d0">МИКРОСТРУКТУРА</data>
