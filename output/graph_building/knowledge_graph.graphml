      <data key="d3" />
      <data key="d4">структура оба сталь становиться двухфазный, состоять из феррит и бейнитно-мартенситный участок</data>
    </node>
    <node id="N101365fc7fb6cf44">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
