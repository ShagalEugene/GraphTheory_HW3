    </edge>
    <edge source="Naf1c78c91107a7e3" target="N60e016d196acae2e">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">изготавливать с применение термомеханический контролировать прокатка (ТМКП)</data>
    </edge>
    <edge source="Naf1c78c91107a7e3" target="N2c435bcd61ca82c8">
