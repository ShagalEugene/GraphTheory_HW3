    </node>
    <node id="N8b2c75d1f5dd7cb9">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">прокатный валка</data>
      <data key="d2">валок для деформации образца</data>
      <data key="d3" />
      <data key="d4">1 — прокатный валка</data>
    </node>
    <node id="Ne86f1781449d01ae">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температурно-деформационный режим</data>
      <data key="d2">режим проведения процесса</data>
      <data key="d3" />
      <data key="d4">так как образец после каждый обжатие практически сразу же попадать в печь с задать температура, где и находиться в течение междеформационный пауза (10 – 12 s), необходимый для установка следующий обжатие и реверс двигатель прокатный валковый</data>
    </node>
    <node id="N99caa7fe11788166">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">окружный скорость валковый прокатный стан</data>
      <data key="d2">параметр движения оборудования</data>
      <data key="d3" />
      <data key="d4">для предотвращение недопустимый подстуживание образец в процесс прокатка холодный валка на рассматривать установка окружный скорость валковый прокатный стан составлять 0,5 m/s</data>
    </node>
    <node id="N874ede04c27be4b3">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">диаметр валка</data>
