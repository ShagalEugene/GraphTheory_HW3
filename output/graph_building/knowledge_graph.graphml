      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура испытания</data>
      <data key="d2">параметр условия проведения механических испытаний</data>
      <data key="d3" />
      <data key="d4">Влияние температура испытание на вид излом образец ИПГ от лист толщина 0,0205 m стать 05Г2МФБ</data>
    </node>
