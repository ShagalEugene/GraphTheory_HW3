    <node id="Ne4c48fee582e3583">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мелкое равноосное зерно</data>
      <data key="d2">структура с малым размером зерна и округлой формой</data>
      <data key="d3" />
      <data key="d4">полный замена деформировать зерно на мелкий равноосный</data>
    </node>
    <node id="N79bbf37a356faf7d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритная микроструктура</data>
      <data key="d2">структура феррита в стали после деформации и охлаждения</data>
      <data key="d3" />
      <data key="d4">Ферритный зерно выделяться главный образ на граница аустенитный зерно</data>
    </node>
    <node id="Nbb269c9280800b3d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">аустенитная микроструктура</data>
      <data key="d2">структура аустенита в стали после деформации при высоких температурах</data>
      <data key="d3" />
      <data key="d4">Аустенитный зерно приобретать удлинённый вдоль направление деформация форма</data>
    </node>
    <node id="N0df29b072e34e103">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">механическая прочность</data>
      <data key="d2">характеристика сопротивления материала разрушению под нагрузкой</data>
      <data key="d3" />
      <data key="d4">в полный мера реализовать следующий механизм повышение прочность лист</data>
    </node>
    <node id="N253da0697a02dddc">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">субструктура</data>
      <data key="d2">внутренняя структура зерна, состоящая из субзерен и границ</data>
      <data key="d3" />
      <data key="d4">образование субструктура</data>
    </node>
    <node id="Nf07fa5c7cd32853e">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">γ→α-превращение</data>
      <data key="d2">структурное превращение аустенита в феррит при охлаждении</data>
      <data key="d3" />
      <data key="d4">Изучать кинетика γ→α-превращение опытный стать 05Г2МФБ</data>
    </node>
    <node id="N4881f910a0e0ed8c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">термомеханический обработка</data>
      <data key="d2">совокупность операций нагрева и деформации</data>
      <data key="d3" />
      <data key="d4">стадию предварительный и окончательный прокатка, применять в промышленный условие. Ставиться задача сравнение два схема контролировать прокатка: 1 — с завершение деформация в аустенитный γ-область; 2 — с завершение деформация двухфазный γ+α-область.</data>
    </node>
    <node id="N1ac69bdfca5cfd49">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">аустенитный γ-область</data>
      <data key="d2">фаза аустенита при высоких температурах</data>
      <data key="d3" />
      <data key="d4">1 — с завершение деформация в аустенитный γ-область</data>
    </node>
    <node id="Nf7ab45625502fa1f">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">двухфазный γ+α-область</data>
      <data key="d2">смешанная фаза аустенита и феррита</data>
      <data key="d3" />
      <data key="d4">2 — с завершение деформация двухфазный γ+α-область</data>
    </node>
    <node id="N2efe55eb4473ce53">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">выдержка</data>
      <data key="d2">стадия удержания температуры перед охлаждением</data>
      <data key="d3" />
      <data key="d4">и выдержка в течение 10 минута</data>
    </node>
    <node id="N4a336ebec4039cb2">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">охлаждение</data>
      <data key="d2">процесс снижения температуры образца</data>
      <data key="d3" />
      <data key="d4">После это образец охлаждать вместе с печь до температура ~1273,15 K</data>
    </node>
    <node id="N82bdc7a98df2bf78">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">γ-область</data>
      <data key="d2">термодинамическая область существования аустенита</data>
      <data key="d3" />
      <data key="d4">в нижний часть γ-область (840-800 K)</data>
    </node>
    <node id="N388ae03ed0dc4ab6">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">межкритический область</data>
      <data key="d2">термодинамическая область смешанного фазового состояния</data>
      <data key="d3" />
      <data key="d4">и в межкритический область (780-740 K)</data>
    </node>
    <node id="N05e1f2aff41e2b2b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">бейнитная область</data>
      <data key="d2">термодинамическая область распада аустенита в бейнитную структуру</data>
      <data key="d3" />
      <data key="d4">линия B$_{H}$ лежать лишь на 5-10 K ниже</data>
    </node>
    <node id="N274ddf14dcadd26e">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">твердость</data>
      <data key="d2">характеристика сопротивления материала деформации</data>
      <data key="d3" />
      <data key="d4">твёрдость металл иметь максимальный значение</data>
    </node>
    <node id="N3ce8b1c7655d3b60">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мартенситная структура</data>
      <data key="d2">структура, образованная при быстром охлаждении</data>
      <data key="d3" />
      <data key="d4">образование практически полностью мартенситный структура</data>
    </node>
    <node id="N7f82fcb2ffccedba">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">бейнитная структура</data>
      <data key="d2">структура, образующаяся при непрерывном охлаждении</data>
      <data key="d3" />
      <data key="d4">увеличение доля бейнитный составлять формироваться в образец</data>
    </node>
    <node id="Ne7ccedf2715ae94b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">высокоуглеродистый мартенсит</data>
      <data key="d2">вид мартенсита с высоким содержанием углерода</data>
      <data key="d3" />
      <data key="d4">участок высокоуглеродистый мартенсит</data>
    </node>
    <node id="Neb02ba881499b1ed">
      <data key="d0">СВОЙСТВО</data>
