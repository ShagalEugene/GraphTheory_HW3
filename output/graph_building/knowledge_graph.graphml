    </edge>
    <edge source="Nd496d2e9ea89100b" target="N3b9ccbadba40bfd9">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">сталь характеризоваться как гетерофазный, состоять из феррит</data>
    </edge>
    <edge source="Nd496d2e9ea89100b" target="N97ea0c6702221aaf">
