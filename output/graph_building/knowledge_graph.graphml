      <data key="d2">характеристика прочности на ударное воздействие</data>
      <data key="d3" />
      <data key="d4">Максимальный значение ударный вязкость ОШЗ стать 05Г2МФБ наблюдаться при формирование в она один структурный составлять — низкоуглеродистый бейнит.</data>
    </node>
    <node id="Nba343b890b9825d5">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">ударный вязкость KCV</data>
      <data key="d2">механическое свойство материала</data>
      <data key="d3">KCV; ударный вязкость</data>
      <data key="d4">низкий содержание углерод отвечать требование по уровень ударный вязкость KCV при 253,15 K</data>
    </node>
    <node id="Nd0d6123594b87fc3">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">твердость HV</data>
      <data key="d2">параметр механических свойств</data>
      <data key="d3">HV; твёрдость</data>
      <data key="d4">твёрдость имитировать околошовный зона не достигать критический величина 350 HV</data>
    </node>
    <node id="N6944f830fe7ff31f">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-бейнитная</data>
      <data key="d2">структура, обеспечивающая высокую хладостойкость при сварке</data>
      <data key="d3" />
      <data key="d4">опытный ферритно-бейнитный микролегировать ниобий и молибден сталь 05Г2МФБ</data>
    </node>
    <node id="N66bb914d17cec220">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">ТТ 232-02-2003</data>
      <data key="d2">техническое требование на прокат толстолистовой стали</data>
      <data key="d3" />
      <data key="d4">ТТ 232-02-2003 «Прокат толстолистовой из низколегированный стать для электросварной прямошовный труба категория прочность К65» получить патент Украина № и 2005 10847 [168].</data>
    </node>
    <node id="N113105598bc6e123">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">прокатка листовой стали</data>
      <data key="d2">технология производства листа из стали категории К65</data>
      <data key="d3" />
      <data key="d4">ТТ 232-02-2003 «Прокат толстолистовой из низколегированный стать для электросварной прямошовный труба категория прочность К65» получить патент Украина № и 2005 10847 [168].</data>
    </node>
