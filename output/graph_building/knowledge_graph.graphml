      <data key="d2">метод внепечной обработки для снижения содержания растворенных газов</data>
      <data key="d3" />
      <data key="d4">метод вакуумирования жидкий стать, предложить А.А. Самарин и Л.М. Новик</data>
    </node>
    <node id="N51c7e5128cb110ea">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">термодиффузионный обработка прокат</data>
      <data key="d2">технология обработки листа для снижения содержания водорода</data>
      <data key="d3" />
      <data key="d4">технология термодиффузионный обработка прокат, предусматривать вылёживание лист в стоп</data>
    </node>
    <node id="N3f8e6a6fccdb65b5">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">выделение кислород из металл</data>
      <data key="d2">процесс выделения кислорода из расплавленного металла</data>
      <data key="d3" />
      <data key="d4">раскисление иметься в стать углерод (2C+O₂=2CO), а вакуум ускорять выделение кислород из металл</data>
    </node>
    <node id="Nf0dadabbbf0dfa7a">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
