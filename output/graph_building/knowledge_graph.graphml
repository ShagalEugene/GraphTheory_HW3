    <edge source="Ne421a1f6d237e8a3" target="N6acf8c850aae02fd">
      <data key="d5">ТОРМОЗИТ</data>
      <data key="d6">2</data>
      <data key="d7">В настоящий время не вызывать сомнение тот факт, что наиболее эффективный способ измельчение конечны</data>
    </edge>
