  <graph edgedefault="undirected">
    <node id="N6740ed138d88ff0a">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">газопровод</data>
      <data key="d2">магистральный трубопровод для транспортировки природного газа</data>
      <data key="d3" />
      <data key="d4">В России запланировано строительство мощных магистральных газопроводов</data>
    </node>
    <node id="N2ae32a4d1637fd9c">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">рабочее давление</data>
      <data key="d2">параметр эксплуатации газопровода, характеризующий нагрузку на трубопровод</data>
      <data key="d3" />
      <data key="d4">прежде всего рабочего давления газа</data>
    </node>
    <node id="N3afb0cb0e62b1cf7">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">вязкость</data>
      <data key="d2">свойство основного металла трубопровода, характеризующее сопротивление течению</data>
      <data key="d3" />
      <data key="d4">требования к вязкости и хладостойкости основного металла</data>
    </node>
    <node id="N6e611784012cc17c">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">К65</data>
      <data key="d2">категория прочности стали для газопроводных труб</data>
      <data key="d3" />
      <data key="d4">Создание новых сталей для магистральных газопроводов категории прочности К65 в настоящей работе должно было осуществляться путем решения ряда металловедческих задач с учетом технологических возможностей оборудования, прежде всего листового стана 3600, имеющегося в настоящее время на металлургическом комбинате «МК «Азовсталь».</data>
    </node>
    <node id="N4b16f1a2e6e14965">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">свариваемость</data>
      <data key="d2">технологическое свойство материала</data>
      <data key="d3" />
      <data key="d4">ля их изготовления, одновременно требует увеличения ударной вязкости, сопротивления хрупкому разрушению и улучшения свариваемости, так как возрастает ответственность за надежную работу магистралей, внутри которых сосредоточена огромная потенциальная энергия транспортируемого газа.</data>
    </node>
    <node id="N4b6c91344b544655">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">ударная вязкость</data>
      <data key="d2">механическое свойство материала</data>
      <data key="d3">KCV; вязкость; предела текучести, относительного удлинения и ударной вязкости; ударной вязкости</data>
      <data key="d4">ля их изготовления, одновременно требует увеличения ударной вязкости, сопротивления хрупкому разрушению и улучшения свариваемости, так как возрастает ответственность за надежную работу магистралей, внутри которых сосредоточена огромная потенциальная энергия транспортируемого газа.</data>
    </node>
    <node id="N583a885ca389d360">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">сопротивление хрупкому разрушению</data>
      <data key="d2">механическое свойство материала</data>
      <data key="d3" />
      <data key="d4">ля их изготовления, одновременно требует увеличения ударной вязкости, сопротивления хрупкому разрушению и улучшения свариваемости, так как возрастает ответственность за надежную работу магистралей, внутри которых сосредоточена огромная потенциальная энергия транспортируемого газа.</data>
    </node>
    <node id="N4b3a064d4160d850">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-перлитная структура</data>
      <data key="d2">структура состоящая из феррита и перлита</data>
      <data key="d3" />
      <data key="d4">и требует перехода к иному структурному состоянию материала — к сталям с дисперсной ферритно-бейнитной структурой, упрочненной частицами карбонитридных фаз ниобия и ванадия</data>
    </node>
    <node id="N1dc445f8ba905353">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">дисперсная ферритно-бейнитная структура</data>
      <data key="d2">структура состоящая из феррита и бейнита</data>
      <data key="d3" />
      <data key="d4">и требует перехода к иному структурному состоянию материала — к сталям с дисперсной ферритно-бейнитной структурой, упрочненной частицами карбонитридных фаз ниобия и ванадия</data>
    </node>
