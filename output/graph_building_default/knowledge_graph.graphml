      <data key="d1">рекристаллизация</data>
      <data key="d2">восстановление структуры горячедеформированного аустенита</data>
      <data key="d3" />
      <data key="d4">статическая рекристаллизация горячедеформированного аустенита</data>
    </node>
    <node id="N2b2642fef0a835bb">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитриды ванадия ниобия титана</data>
      <data key="d2">фазы с кубической гранецентрированной решеткой, растворимые друг в друге</data>
      <data key="d3" />
      <data key="d4">и карбонитриды ванадия, ниобия и титана имеют кубическую гранецентрированную решетку и полностью растворимы друг в друге</data>
    </node>
    <node id="N6ea4e1a9a01a2e99">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">микролегированные стали</data>
      <data key="d2">стали с добавками микролегирующих элементов</data>
      <data key="d3" />
      <data key="d4">в микролегированных сталях могут встречаться не только карбонитриды с одним карбидообразующим элементом, но избыточные фазы сложного состава</data>
    </node>
    <node id="N603e1a84e5903775">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">нитрид титана</data>
      <data key="d2">труднорастворимые крупные частицы нитрида титана</data>
      <data key="d3">TiN</data>
      <data key="d4">часть титана связывается в труднорастворимые, крупные частицы нитрида титана TiN</data>
    </node>
    <node id="N213dbc3e9f00e1fd">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитриды ванадия</data>
      <data key="d2">избыточные фазы ванадия, тормозящие рекристаллизацию</data>
      <data key="d3" />
      <data key="d4">интенсивное выделение карбонитридов ванадия</data>
    </node>
    <node id="Na94ab0fb79cd8a04">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">статическая рекристаллизация</data>
      <data key="d2">процесс восстановления структуры аустенита</data>
      <data key="d3" />
      <data key="d4">способных тормозить процесс статической рекристаллизации</data>
    </node>
    <node id="Nf5c5490323d68155">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитрид ниобия</data>
      <data key="d2">фазовое соединение ниобия с углеродом и азотом</data>
      <data key="d3" />
      <data key="d4">выделения карбонитридов ниобия</data>
    </node>
    <node id="Nc2af3d7c599dfe37">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">смешанная структура</data>
      <data key="d2">структура с разной плотностью дефектов кристаллической решетки</data>
      <data key="d3" />
      <data key="d4">Такая смешанная структура, с разной плотностью дефектов кристаллической решетки, приводит к значительному увеличению потенциальных мест для зарождения избыточных фаз [97].</data>
    </node>
    <node id="N0234a0eef7983cdc">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">выделение вторичных фаз ниобия</data>
      <data key="d2">интенсивное выделение частиц ниобия размером 3-7 нм</data>
      <data key="d3" />
      <data key="d4">В результате этого в интервале температур $T_{5}$ — $T_{95}$ происходит интенсивное выделение вторичных фаз ниобия размером 3-7 нм, которые окончательно подавляют рекристаллизацию аустенита.</data>
    </node>
    <node id="Ndb3911dd005b2ca3">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">удельная эффективная поверхность</data>
      <data key="d2">характеристика структурного состояния аустенита</data>
      <data key="d3" />
      <data key="d4">S$_{v}$</data>
    </node>
    <node id="Nd81632c065924018">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">Sv</data>
      <data key="d2">параметр вязкости стали</data>
      <data key="d3" />
      <data key="d4">S$_{v}$</data>
    </node>
    <node id="N7b51f8b81cd207db">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">размер ферритного зерна</data>
      <data key="d2">размер зерна ферритной фазы после полиморфного превращения</data>
      <data key="d3" />
      <data key="d4">размер ферритного зерна</data>
    </node>
    <node id="N6bc24fda043e25da">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">Cu</data>
      <data key="d2">медь, снижающая критическую точку распада аустенита</data>
      <data key="d3" />
      <data key="d4">- 2 0 C u</data>
    </node>
    <node id="Ned629ab5cf758eac">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">устойчивость аустенита</data>
      <data key="d2">характеристика стабильности фазы аустенита</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Nfe832847168ecb98">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">низкотемпературное_превращение</data>
      <data key="d2">процесс фазового перехода при охлаждении ниже критических температур</data>
      <data key="d3" />
      <data key="d4">ти аустенита способствует образованию большего количества продуктов низкотемпературного превращения</data>
    </node>
    <node id="Nb295aeba3d81e31f">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">низкоуглеродистая_сталь</data>
      <data key="d2">сталь с низким содержанием углерода</data>
      <data key="d3" />
      <data key="d4">в низкоуглеродистых сталях увеличение прокаливаемости приводит к повышению прочности и вязкости</data>
    </node>
    <node id="Na364e8ae16874178">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">верхний_бейнит</data>
      <data key="d2">модификация бейнита, образующаяся в высокоуглеродистых сталях</data>
      <data key="d3" />
      <data key="d4">в сталях с повышенным содержанием углерода ... образуется высокоуглеродистый верхний бейнит</data>
    </node>
    <node id="Nf4c9e084a17abda2">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">ферритно-бейнитные стали</data>
      <data key="d2">класс сталей с измельченной структурой для повышения прочности и вязкости</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Nc9334c059ca78ab0">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">низкоуглеродистые стали</data>
      <data key="d2">класс сталей, рекомендуемый для применения из-за свойств</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N37374cb8f316c7a7">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">бейнит</data>
      <data key="d2">микрокристаллическая структура с пластинками</data>
      <data key="d3">Б; Кроме феррита в микроструктуре стали 05Г2МФБ наблюдались продукты промежуточного; бейнит темная составляющая; бейнитная структура; бейнитные пластины</data>
      <data key="d4">приводит к образованию микроструктуры, состоящей из феррита и некоторого количества бейнита</data>
    </node>
    <node id="Nb18700665fec05e7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">дисперсионное_твердение</data>
      <data key="d2">усиление материала за счёт выделения дисперсных частиц</data>
      <data key="d3" />
      <data key="d4">эффективны для дисперсионного твердения частицы размером примерно от 1 до 2 нм</data>
    </node>
    <node id="N17afbf61f3b6c65c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">комплексное микролегирование</data>
      <data key="d2">метод добавления нескольких элементов для улучшения свойств</data>
      <data key="d3" />
      <data key="d4">комплексное микролегирование</data>
    </node>
    <node id="N84a27b8c6d472581">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">аустенитизация</data>
      <data key="d2">нагрев слябов для формирования структуры и свойств металла</data>
      <data key="d3" />
      <data key="d4">нагрев слябов является одним из важных технологических этапов, обеспечивающих формирование необходимой структуры и комплекса механических свойств металла</data>
    </node>
    <node id="N92d7bca0f9771ba2">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">зерно аустенита</data>
      <data key="d2">характеристика структуры металла по размеру зерна</data>
      <data key="d3" />
      <data key="d4">перед проведением предварительной прокатки желательно, чтобы зерно аустенита было достаточно мелким и равномерным</data>
    </node>
    <node id="N401878cbf03616ea">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">ну зерна</data>
      <data key="d2">параметр структуры твердого раствора</data>
      <data key="d3" />
      <data key="d4">ну зерна и химический состав твердого раствора вследствие растворения избыточных фаз</data>
    </node>
    <node id="Nbc84100ab7b48736">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">твердый раствор</data>
      <data key="d2">материал в виде твердого раствора</data>
      <data key="d3" />
      <data key="d4">твердый раствор вследствие растворения избыточных фаз</data>
    </node>
    <node id="Nb7780f7808839f7f">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">свободная энергия</data>
      <data key="d2">термодинамический параметр системы</data>
      <data key="d3" />
      <data key="d4">избыток свободной энергии системы, которая создает движущую силу, необходимую для последующего роста зерен</data>
    </node>
    <node id="N9a51dc23174d9279">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">зернограничная поверхность</data>
      <data key="d2">параметр структуры твердого раствора</data>
      <data key="d3" />
      <data key="d4">Мелкозернистая структура имеет повышенную зернограничную поверхность на единицу объема</data>
    </node>
    <node id="Nae8918b62b2903cc">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мелкозернистая структура</data>
      <data key="d2">структура с мелким размером зерна аустенита</data>
      <data key="d3" />
      <data key="d4">Мелкозернистая структура имеет повышенную зернограничную поверхность на единицу объема</data>
    </node>
    <node id="N986d0e359158634f">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">Al</data>
      <data key="d2">добавка в сталь для задержания аномального роста зерна</data>
      <data key="d3" />
      <data key="d4">Добавки ванадия и алюминия задерживают аномальный рост зерна до температур 1000-1150 °C</data>
    </node>
    <node id="N5952bc0f620ab5b7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рост зерна</data>
      <data key="d2">процесс увеличения размеров зерен аустенита</data>
      <data key="d3" />
      <data key="d4">аномальный рост зерна не наблюдается в простых низколегированных Si-Mn-сталях</data>
    </node>
    <node id="N14e7cd7576678e2e">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">статическая_рекристаллизация</data>
      <data key="d2">процесс восстановления структуры горячедеформированного аустенита</data>
      <data key="d3" />
      <data key="d4">статическая рекристаллизация</data>
    </node>
    <node id="N97581ec4d61e736c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">статический_возврат</data>
      <data key="d2">процесс уменьшения плотности дислокаций без изменения размера зерен</data>
      <data key="d3" />
      <data key="d4">статический возврат</data>
    </node>
    <node id="N749496fe0bb6a690">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">аустенит</data>
      <data key="d2">горячедеформированная фаза стали</data>
      <data key="d3" />
      <data key="d4">аустенит</data>
    </node>
    <node id="Nde4a9b6905c7869f">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">разупрочнение</data>
      <data key="d2">снижение сопротивления деформации материала</data>
      <data key="d3" />
      <data key="d4">разупрочнение</data>
    </node>
    <node id="N05db197be549011a">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">Si</data>
      <data key="d2">химический элемент, входящий в состав стали</data>
      <data key="d3" />
      <data key="d4">Si</data>
    </node>
    <node id="Nc2960ed3a3461787">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">прокатка</data>
      <data key="d2">технологическая операция деформации металла</data>
      <data key="d3" />
      <data key="d4">предварительная прокатка</data>
    </node>
    <node id="Nbcab92643b915f9d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">укрупнение зерна</data>
      <data key="d2">увеличение среднего размера кристаллитов</data>
      <data key="d3" />
      <data key="d4">укрупнение зерна на 3 балла</data>
    </node>
    <node id="Nb184e8c27a2950e0">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">пауза</data>
      <data key="d2">время выдержки между операциями</data>
      <data key="d3" />
      <data key="d4">пауза</data>
    </node>
    <node id="N101bafe8db2dcf40">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Низкотемпературная контролируемая прокатка</data>
      <data key="d2">процесс деформации при температурах ниже температуры рекристаллизации аустенита</data>
      <data key="d3" />
      <data key="d4">Низкотемпературная контролируемая прокатка. Реализуются все три стадии деформации (I стадия &gt;T$_{p}$, II стадия —T$_{p}$.....Ar$_{3}$, III стадия — Ar$_{3}$.....Ar$_{1}$).</data>
    </node>
    <node id="N5c80d77d2b9419ef">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Рекристаллизационная контролируемая прокатка</data>
      <data key="d2">процесс деформации при температурах выше температуры рекристаллизации аустенита</data>
      <data key="d3" />
      <data key="d4">Рекристаллизационную контролируемую прокатку проводят при температурах выше температуры рекристаллизации аустенита [129, 130].</data>
    </node>
    <node id="N5f4a843b2647a155">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мелкозернистая аустенитная структура</data>
      <data key="d2">структура с мелким размером зерна аустенита, формируемая при контролируемой прокатке</data>
      <data key="d3" />
      <data key="d4">В результате многократной рекристаллизации и деформации в листах формируется мелкозернистая аустенитная структура.</data>
    </node>
    <node id="Na38ac5cf316bd1c4">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">многократная рекристаллизация</data>
      <data key="d2">процесс восстановления структуры между проходами прокатки</data>
      <data key="d3" />
      <data key="d4">Основная суть ее заключается в максимальном измельчении конечной микроструктуры, что достигается посредством статической рекристаллизации аустенита, протекающей при температурах выше температуры рекристаллизации во время пауз между проходами.</data>
    </node>
    <node id="N82ec8e5739ee9b16">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура конца прокатки</data>
      <data key="d2">параметр режима прокатки, определяющий условия формирования структуры</data>
      <data key="d3" />
      <data key="d4">температуры конца прокатки</data>
    </node>
    <node id="N336f71b527850e57">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">прокатные валки</data>
      <data key="d2">оборудование для формирования профиля листа</data>
      <data key="d3" />
      <data key="d4">выхода головного конца листа из прокатных валков</data>
    </node>
    <node id="N9dfedc654ef481d1">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">окончательная прокатка</data>
      <data key="d2">процесс обработки давлением при температурах ниже температуры рекристаллизации</data>
      <data key="d3" />
      <data key="d4">При окончательной прокатке, которая проводится при температурах ниже температуры рекристаллизации, аустенитное зерно приобретает удлиненную форму и характеризуется следующими особенностями [12]</data>
    </node>
    <node id="N098660002759b88b">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">деформация</data>
      <data key="d2">процесс изменения формы материала при прокатке, определяющий размер зерна феррита</data>
      <data key="d3">деформация образцов</data>
      <data key="d4">При высокотемпературной контролируемой прокатке размер зерна феррита во многом определяется суммарной деформацией при температурах отсутствия рекристаллизации</data>
    </node>
    <node id="N53cd96d37b301956">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">толщина подката</data>
      <data key="d2">параметр толщины материала на стадии окончательной прокатки, влияющий на структуру</data>
      <data key="d3" />
      <data key="d4">толщина подката для окончательной стадии прокатки, которая должна в 3,5-4 раза превышать конечную толщину листа [12]</data>
    </node>
    <node id="N7b7acbce8afb6c06">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">ускоренное охлаждение</data>
      <data key="d2">технология охлаждения с высокой скоростью</data>
      <data key="d3" />
      <data key="d4">Ускоренное охлаждение предупреждает превращение в перлит</data>
    </node>
    <node id="Ne9aeb663145d0069">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">игольчатые продукты распада аустенита</data>
      <data key="d2">микрокристаллическая структура, образующаяся при охлаждении</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N92dc60e449afd61e">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">вторичные ликвационные явления</data>
      <data key="d2">неоднородность химического состава в структуре</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N98903ac57e359c15">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">строчечная структура</data>
      <data key="d2">структурный дефект, проявляющийся в виде полосчатости</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N4d8c806719154a5c">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">строительные конструкции</data>
      <data key="d2">конструкции для строительства в суровых климатических зонах</data>
      <data key="d3" />
      <data key="d4">используемых в арктических условиях и для судостроения</data>
    </node>
    <node id="Nd855e5259159ce71">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">судостроение</data>
      <data key="d2">отрасль промышленности, использующая специальные листы</data>
      <data key="d3" />
      <data key="d4">для судостроения</data>
    </node>
    <node id="N890df5c424cda7c0">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">низколегированная сталь К60</data>
      <data key="d2">категория прочности стали с ферритно-перлитной структурой</data>
      <data key="d3" />
      <data key="d4">Охлаждение на воздухе листов из низколегированной стали категории прочности К60</data>
    </node>
    <node id="N71a11be4efa407aa">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">легирование элементами</data>
      <data key="d2">добавление химических элементов для повышения прочности и вязкости</data>
      <data key="d3" />
      <data key="d4">обычно достигается путем легирования элементами, повышающими устойчивость аустенита</data>
    </node>
    <node id="N65ec813558cff9c5">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">прокатка в межкритической области</data>
      <data key="d2">деформация стали при пониженной температуре прокатки в межкритическую область</data>
      <data key="d3" />
      <data key="d4">понижение температуры прокатки в межкритическую область способствует значительному измельчению структуры готовой стали</data>
    </node>
    <node id="Nc27d78469047f698">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">измельчение структуры</data>
      <data key="d2">результат деформации, приводящий к уменьшению размера зерен</data>
      <data key="d3" />
      <data key="d4">значительному измельчению структуры готовой стали</data>
    </node>
    <node id="N7213a4635eaa5fb0">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">γ→α-превращение</data>
      <data key="d2">структурное изменение при деформации в двухфазной области</data>
      <data key="d3" />
      <data key="d4">γ→α-превращение в процессе деформации</data>
    </node>
    <node id="N7bee1653e2ae184d">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">превращение остаточного аустенита</data>
      <data key="d2">структурное изменение после завершения деформации</data>
      <data key="d3" />
      <data key="d4">после завершения деформации происходит превращение остаточного аустенита в феррит, перлит или бейнит</data>
    </node>
    <node id="N70a7fdb8c4fe6b96">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">развитая субструктура</data>
      <data key="d2">состояние материала, сформировавшееся в результате процессов возврата и полигонизации</data>
      <data key="d3" />
      <data key="d4">развитая субструктура</data>
    </node>
    <node id="N253da0697a02dddc">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">субструктура</data>
      <data key="d2">внутренняя структура деформированного феррита</data>
      <data key="d3" />
      <data key="d4">субструктура</data>
    </node>
    <node id="Ndf64a6499ddf45cd">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">γ→α-превращение</data>
      <data key="d2">фазовый переход из аустенита в феррит</data>
      <data key="d3" />
      <data key="d4">γ→α-превращение</data>
    </node>
    <node id="Ne569b15cd772a42e">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">предварительная деформация</data>
      <data key="d2">стадия контролируемой прокатки перед окончательной обработкой</data>
      <data key="d3" />
      <data key="d4">Недостаточно изучены процессы формирования аустенитного зерна во время предварительной деформации</data>
    </node>
    <node id="N948160cacbb0d31b">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">комплекс механических свойств</data>
      <data key="d2">характеристики материала</data>
      <data key="d3" />
      <data key="d4">обеспечивающую получение комплекса механических свойств, соответствующих категории прочности К65</data>
    </node>
    <node id="Nd952393f1b8c6a1a">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура нагрева</data>
      <data key="d2">параметр технологического режима</data>
      <data key="d3">максимальная температура</data>
      <data key="d4">Исследовать влияние температуры нагрева</data>
    </node>
    <node id="Nb62687737dfc2f92">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">параметры предварительной прокатки</data>
      <data key="d2">параметры технологического процесса</data>
      <data key="d3" />
      <data key="d4">параметров предварительной прокатки на формирование аустенитного зерна стали</data>
    </node>
    <node id="N88bec102cfadfef1">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">ферритно-бейнитный класс</data>
      <data key="d2">класс сталей для труб</data>
      <data key="d3" />
      <data key="d4">Исследовать вклад трубного передела в формирование механических свойств основного металла готовых труб сталей ферритно-бейнитного и ферритно-перлитного классов.</data>
    </node>
    <node id="N78fafe13b0a470fd">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">ферритно-перлитный класс</data>
      <data key="d2">класс сталей для труб</data>
      <data key="d3" />
      <data key="d4">Исследовать вклад трубного передела в формирование механических свойств основного металла готовых труб сталей ферритно-бейнитного и ферритно-перлитного классов.</data>
    </node>
    <node id="N75a644ac8d9374c7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">микролегирование повышенным количеством ниобия</data>
      <data key="d2">процесс микролегирования</data>
      <data key="d3" />
      <data key="d4">микролегирование повышенным количеством ниобия, эффективно сдерживающего рекристаллизацию горячедеформированного аустенита</data>
    </node>
    <node id="N7c00efe4a481dd9c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рекристаллизация горячедеформированного аустенита</data>
      <data key="d2">процесс рекристаллизации</data>
      <data key="d3" />
      <data key="d4">эффективно сдерживающего рекристаллизацию горячедеформированного аустенита</data>
    </node>
    <node id="Nf261537ed45f2727">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">структура с повышенной плотностью дислокаций</data>
      <data key="d2">микроструктурное состояние металла, характеризующееся высокой плотностью дефектов кристаллической решётки</data>
      <data key="d3" />
      <data key="d4">упрочнение металла в результате формирования структуры с повышенной плотностью дислокаций</data>
    </node>
    <node id="N5f66e598ee6d16c7">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитриды ниобия</data>
      <data key="d2">дисперсные фазы, образующиеся при легировании ниобием</data>
      <data key="d3" />
      <data key="d4">выделения карбонитридов ниобия</data>
    </node>
    <node id="N2beb00978bbfee1d">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">эффект дисперсионного упрочнения</data>
      <data key="d2">механизм повышения прочности материала за счет выделения частиц второй фазы</data>
      <data key="d3" />
      <data key="d4">использование эффекта дисперсионного упрочнения за счет выделения карбонитридов ниобия и ванадия</data>
    </node>
    <node id="N5da84f2803dc1e2e">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">Ni</data>
      <data key="d2">элемент для регулирования кинетики превращения аустенита</data>
      <data key="d3" />
      <data key="d4">Для регулирования кинетики превращения горячедеформированного аустенита опытная сталь была экономно легирована, молибденом, никелем</data>
    </node>
    <node id="Nc656fba8505072ff">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">углеродный эквивалент CE</data>
      <data key="d2">параметр CE</data>
      <data key="d3" />
      <data key="d4">CE=0,41%</data>
    </node>
    <node id="N31217298aab81e5b">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">параметр трещиностойкости PCM</data>
      <data key="d2">параметр PCM</data>
      <data key="d3" />
      <data key="d4">PCM = 0,20 %</data>
    </node>
    <node id="N921233a24f74b686">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">электролит</data>
      <data key="d2">раствор для травления шлифов сталей</data>
      <data key="d3" />
      <data key="d4">860 мл ортофосфорной кислоты и 100 г хромового ангидрида</data>
    </node>
    <node id="N9499feb524c31e8f">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">ортофосфорная кислота</data>
      <data key="d2">кислота H3PO4</data>
      <data key="d3" />
      <data key="d4">H3PO4</data>
    </node>
    <node id="Nda284a88edbe4c0f">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">непрерывное_охлаждение</data>
      <data key="d2">режим охлаждения образцов после деформации</data>
      <data key="d3" />
      <data key="d4">необходимые условия нагрева и деформации образцов размером 10×8×6 мм достигали на лабораторной прокатной установке, схема которой приведена на рисунке 2.1. Эта установка благодаря наличию 2-х трубчатых микропечей 2, установленных непосредственно у прокатных валков 1, позволяла проводить многократную деформацию малых образцов 3 по любому заданному температурно-деформационному режиму</data>
    </node>
    <node id="N9c311eb090d747ba">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">печь для нагрева и охлаждения образцов</data>
      <data key="d2">устройство для термической обработки в процессе прокатки</data>
      <data key="d3" />
      <data key="d4">атной установки: 2 — печь для нагрева и охлаждения образцов</data>
    </node>
    <node id="N695c435c4138e8a7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Дифференциальный_термический_метод</data>
      <data key="d2">метод обнаружения малых тепловых эффектов на основе измерения разности температур</data>
      <data key="d3" />
      <data key="d4">Дифференциальный термический метод, позволяющий обнаружить весьма малые тепловые эффекты, основан на измерении разности температур образца и эталона.</data>
    </node>
    <node id="Nbcb570cd3bbdcfab">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">сталь 09X18H10T</data>
      <data key="d2">эталонная сталь для дифференциального термического анализа</data>
      <data key="d3" />
      <data key="d4">В качестве эталона служила сталь 09X18H10T, которая не испытывала фазовых превращений в исследуемом интервале температур и имела теплоемкость, близкую к теплоемкости образца.</data>
    </node>
    <node id="N47cdd18f9db4b0b9">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">дилатометр</data>
      <data key="d2">прибор для регистрации дилатометрической кривой</data>
      <data key="d3" />
      <data key="d4">и этом использовали специальный дилатометр, который позволяет быстро (за 1-2 с) устанавливать в держатели только что прокатанный образец и сразу же начинать регистрацию дилатометрической кривой [159].</data>
    </node>
    <node id="N0c3d49661b36c58c">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">прокатанный_образец</data>
      <data key="d2">металлический образец, прошедший прокатку</data>
      <data key="d3" />
      <data key="d4">и этом использовали специальный дилатометр, который позволяет быстро (за 1-2 с) устанавливать в держатели только что прокатанный образец и сразу же начинать регистрацию дилатометрической кривой [159].</data>
    </node>
    <node id="N0e6a6ff30795cbe7">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">термопара</data>
      <data key="d2">датчик температуры для измерения разности температур</data>
      <data key="d3" />
      <data key="d4">На рис. 2.2 показаны термопары, место зачеканки их спаев в образец и эталон, и подключение их к потенциометру.</data>
    </node>
    <node id="N0179ff2f4edb1694">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">двухкоординатный потенциометр</data>
      <data key="d2">прибор для записи дифференцированных кривых</data>
      <data key="d3" />
      <data key="d4">для записи дифференцированных кривых в координатах «разность температур — температура» использовали двухкоординатный потенциометр высокого быстродействия и высокой чувствительности</data>
    </node>
    <node id="N70e7c35355cbe926">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">дифференциальная термическая кривая</data>
      <data key="d2">график изменения температуры при фазовых превращениях</data>
      <data key="d3" />
      <data key="d4">даже изменение разности температур между образцом и эталоном всего на 0,1 °C, вызванной фазовым превращением, приводит к вполне обнаруживаемому перегибу на дифференциальной термической кривой</data>
    </node>
    <node id="N06ed2d6bebe2e745">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">разность температур</data>
      <data key="d2">параметр измерения между образцом и эталоном</data>
      <data key="d3" />
      <data key="d4">если разность температур между образцом и эталоном вследствие малого теплового эффекта превращения была небольшой, то использовали самый чувствительный диапазон — 0 – 0,5 мВ</data>
    </node>
    <node id="Nd58cfbcb7dc24037">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">фазовое превращение</data>
      <data key="d2">процесс изменения структуры материала</data>
      <data key="d3" />
      <data key="d4">даже изменение разности температур между образцом и эталоном всего на 0,1 °C, вызванной фазовым превращением, приводит к вполне обнаруживаемому перегибу на дифференциальной термической кривой</data>
    </node>
    <node id="N0207a6cf590e2587">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">тепловой эффект</data>
      <data key="d2">параметр энергии фазового перехода</data>
      <data key="d3" />
      <data key="d4">если разность температур между образцом и эталоном вследствие малого теплового эффекта превращения была небольшой, то использовали самый чувствительный диапазон — 0 – 0,5 мВ</data>
    </node>
    <node id="N956249f3f0cab527">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">дифференциальная_термопара</data>
      <data key="d2">прибор для регистрации разности температур образца и эталона</data>
      <data key="d3" />
      <data key="d4">использовали одни и те же регистрирующие приборы и термопары к ним</data>
    </node>
    <node id="Nd8e6b9234bf70a70">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура начала превращений</data>
      <data key="d2">характеристика фазовых переходов в стали</data>
      <data key="d3" />
      <data key="d4">с точностью ±5 °C определять температуры начала превращений аустенит-феррит, аустенит-перлит, аустенит-бейнит и аустенит-мартенсит</data>
    </node>
    <node id="Nef4aa77cfcea505a">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мартенсит</data>
      <data key="d2">твердая фаза, образующаяся при быстром охлаждении</data>
      <data key="d3">мартенсит высокоуглеродистый; мартенсита; мартенситная структура</data>
      <data key="d4">$t_{н.м.}$  — мартенсита</data>
    </node>
    <node id="N2b58da4ac49d5e38">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">быстродействующий дилатометр ИМЕТ-ДБ</data>
      <data key="d2">прибор для исследования фазовых превращений</data>
      <data key="d3" />
      <data key="d4">Исследование проводили на быстродействующем дилатометре ИМЕТ-ДБ</data>
    </node>
    <node id="N4522b817a14ab810">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">трубчатый образец</data>
      <data key="d2">образец с внутренним диаметром 4 мм и размерами 6×6 мм</data>
      <data key="d3" />
      <data key="d4">использование трубчатых образцов размерами 6×6 мм, с внутренним диаметром 4 мм</data>
    </node>
    <node id="N7b1b6246a28b6c3a">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">инертный газ</data>
      <data key="d2">газ, используемый для регулирования охлаждения</data>
      <data key="d3" />
      <data key="d4">регулировалось расходом пропускаемого внутри образца инертного газа</data>
    </node>
    <node id="N4eb884b08d1725b1">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">расшифровка фазовых превращений</data>
      <data key="d2">метод определения количества фаз на основе изменения коэффициентов теплового расширения</data>
      <data key="d3" />
      <data key="d4">асшифровка фазовых превращений основывалась на изменении коэффициентов теплового расширения в процессе перехода от одной фазы к другой</data>
    </node>
    <node id="Nbab48345ba96ef66">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">изменение параметров кристаллической решетки</data>
      <data key="d2">параметры, характеризующие структуру материала</data>
      <data key="d3" />
      <data key="d4">в процессе изменения параметров кристаллической решетки</data>
    </node>
    <node id="Nd74304ef394334a7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">метод подобный правилу рычага</data>
      <data key="d2">способ расчета количества фаз</data>
      <data key="d3" />
      <data key="d4">Поэтому при расшифровке кривых для расчета количества фаз в процентах применяли метод, подобный правилу рычага</data>
    </node>
    <node id="N498dbd8ddf2b7434">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">металлографический метод</data>
      <data key="d2">способ оценки количества структурных фаз</data>
      <data key="d3" />
      <data key="d4">Предварительно на опытных сталях установили сопоставимость данных расшифровки с металлографическим методом с использованием анализатора изображения SIAMS-600</data>
    </node>
    <node id="Ndf04be96ee907fc6">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">ударный_изгиб</data>
      <data key="d2">метод оценки склонности к хрупкому разрушению</data>
      <data key="d3" />
      <data key="d4">Склонность к хрупкому разрушению оценивали по результатам испытания на ударный изгиб образцов с имитированной микроструктурой металла околошовной зоны.</data>
    </node>
    <node id="N8c2f62950377d6f6">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">хрупкое_разрушение</data>
      <data key="d2">нежелательное свойство материала</data>
      <data key="d3" />
      <data key="d4">Склонность к хрупкому разрушению оценивали по результатам испытания на ударный изгиб образцов с имитированной микроструктурой металла околошовной зоны.</data>
    </node>
    <node id="Ne41ec5a80ffa6a01">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">околошовная_зона</data>
      <data key="d2">зона в сварном шве</data>
      <data key="d3" />
      <data key="d4">Имитированную микроструктуру ОШЗ получали путем индукционного нагрева ударных образцов до температуры 1300 °C.</data>
    </node>
    <node id="Nabf3d8214825294b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">имитированная_микроструктура</data>
      <data key="d2">условно созданная структура металла</data>
      <data key="d3" />
      <data key="d4">Имитированную микроструктуру ОШЗ получали путем индукционного нагрева ударных образцов до температуры 1300 °C.</data>
    </node>
    <node id="N11303920c532f9fb">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">индукционный_нагрев</data>
      <data key="d2">способ нагрева образцов</data>
      <data key="d3" />
      <data key="d4">Имитированную микроструктуру ОШЗ получали путем индукционного нагрева ударных образцов до температуры 1300 °C.</data>
    </node>
    <node id="N12e454519367d31d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">холодные_трещины</data>
      <data key="d2">дефект, возникающий при низких температурах</data>
      <data key="d3" />
      <data key="d4">Стойкость стали к образованию холодных трещин оценивали по критической твердости 350 ед. по Виккерсу, ниже которой гарантируется отсутствие образования холодных трещин.</data>
    </node>
    <node id="Nec1f9fddfc510f91">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">сталь</data>
      <data key="d2">металлический сплав</data>
      <data key="d3" />
      <data key="d4">Стойкость стали к образованию холодных трещин оценивали по критической твердости 350 ед. по Виккерсу, ниже которой гарантируется отсутствие образования холодных трещин.</data>
    </node>
    <node id="N8ea06239e6edc340">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">твердость_по_Виккерсу</data>
      <data key="d2">характеристика сопротивления проникновению</data>
      <data key="d3" />
      <data key="d4">Стойкость стали к образованию холодных трещин оценивали по критической твердости 350 ед. по Виккерсу, ниже которой гарантируется отсутствие образования холодных трещин.</data>
    </node>
    <node id="N07e449061352474e">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">пластическая деформация аустенита</data>
      <data key="d2">процесс изменения формы материала</data>
      <data key="d3" />
      <data key="d4">наиболее эффективным способом измельчения конечной структуры низколегированных сталей является пластическая деформация аустенита</data>
    </node>
    <node id="N3c83e6a9b984f90c">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">низколегированная сталь</data>
      <data key="d2">сталь с небольшим количеством легирующих элементов</data>
      <data key="d3">нижколегированная сталь</data>
      <data key="d4">измельчение структуры это единственный структурный фактор, способный одновременно значительно упрочнять сталь</data>
    </node>
    <node id="N4e008a2f22a1ae1b">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">механическое упрочнение</data>
      <data key="d2">повышение прочности материала</data>
      <data key="d3" />
      <data key="d4">измельчение структуры это единственный структурный фактор, способный одновременно значительно упрочнять сталь</data>
    </node>
    <node id="Nba0970e682304121">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">пластическая_деформация_аустенита</data>
      <data key="d2">процесс деформации аустенита по определенному режиму</data>
      <data key="d3" />
      <data key="d4">конечной структуры низколегированных сталей является пластическая деформация аустенита по определенному режиму</data>
    </node>
    <node id="Nb8249cf975a2e0a4">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">удельная_эффективная_поверхность_раздела</data>
      <data key="d2">параметр характеризующий поверхность раздела</data>
      <data key="d3" />
      <data key="d4">создания наибольшей удельной эффективной поверхности раздела</data>
    </node>
    <node id="Ne09c775d8386508c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рекристаллизационные_процессы</data>
      <data key="d2">процесс восстановления структуры металла</data>
      <data key="d3" />
      <data key="d4">величина $S_{v}$ горячедеформированного аустенита зависит от рекристаллизационных процессов протекающих в металле под воздействием деформации</data>
    </node>
    <node id="N7c9ba6d07449a6c8">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">аустенитная_структура</data>
      <data key="d2">микроструктура стали</data>
      <data key="d3" />
      <data key="d4">детальное исследование эволюции аустенитной структуры при контролируемой прокатке имеет не только научное, но и непосредственное практическое значение</data>
    </node>
    <node id="N31ed0cee38196762">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">горячая прокатка</data>
      <data key="d2">процесс деформации металла с нагревом</data>
      <data key="d3" />
      <data key="d4">Для того чтобы формировать частицы, которые могут эффективно воздействовать на микроструктуру стали в процессе горячей прокатки или термической обработки, микролегирующий элемент должен быть первоначально переведен в твердый раствор</data>
    </node>
    <node id="Nd0de921c1906fd75">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">нагрев</data>
      <data key="d2">процесс повышения температуры материала</data>
      <data key="d3">нагрев образца</data>
      <data key="d4">а — нагрев образца до температуры 950 °C, выдержка 10 мин.</data>
    </node>
    <node id="N839179fdea57a269">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритные зерна</data>
      <data key="d2">фаза, выделяющаяся в опытной стали после окончательной прокатки</data>
      <data key="d3" />
      <data key="d4">Ферритные зерна выделялись главным образом на границах аустенитных зерен (рис.3.2 в, г).</data>
    </node>
    <node id="N1334d68e5bdb8df6">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">измельчение зерна</data>
      <data key="d2">механизм повышения прочности за счет динамического превращения</data>
      <data key="d3" />
      <data key="d4">— измельчение зерна, за счет динамического γ→α-превращения из нерекристаллизованного аустенита с большой эффективной поверхностью раздела S$_{v}$;</data>
    </node>
    <node id="N12977a0766381de5">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">деформированный аустенит</data>
      <data key="d2">состояние аустенита после прокатки перед рекристаллизацией</data>
      <data key="d3" />
      <data key="d4">Зарождение зерен феррита при распаде деформированного аустенита наблюдалось в основном на границах деформированных нерекристаллизованных аустенитных зерен</data>
    </node>
    <node id="N8b8ff1503d62adea">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">нерекристаллизованная структура</data>
      <data key="d2">состояние аустенита, не прошедшего процесс рекристаллизации</data>
      <data key="d3" />
      <data key="d4">При температурах окончательной прокатки ниже 850 °C образуется нерекристаллизованная аустенитная структура с вытянутыми вдоль направления прокатки зернами</data>
    </node>
    <node id="Na3800893ea537ca9">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">деформированный аустенит</data>
      <data key="d2">материал, подвергшийся горячей пластической деформации</data>
      <data key="d3" />
      <data key="d4">зерна феррита зарождались на границах деформированных нерекристаллизованных аустенитных зерен</data>
    </node>
    <node id="N9cdcc4b9cd3faa58">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">вытянутая форма</data>
      <data key="d2">форма зерна, вытянутая вдоль направления прокатки</data>
      <data key="d3" />
      <data key="d4">многие зерна феррита подверглись деформационному упрочнению и имели вытянутую вдоль направления прокатки форму</data>
    </node>
    <node id="Nd9d30043787a39f1">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">полиморфное γ+α-превращение</data>
      <data key="d2">процесс фазового перехода из аустенита в феррит</data>
      <data key="d3" />
      <data key="d4">ускоряет полиморфное γ+α-превращение</data>
    </node>
    <node id="N71824dc85714193b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-бейнитно-мартенситная структура</data>
      <data key="d2">структура изделия с увеличивающейся долей феррита в срединных слоях листа</data>
      <data key="d3" />
      <data key="d4">лаждении толстых стальных листов из этой стали можно рассчитывать на получение в изделиях ферритно-бейнитно-мартенситной структуры со значительно увеличивающейся долей феррита в срединных слоях листа.</data>
    </node>
    <node id="Nc4e7955a365c6473">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура окончания деформации</data>
      <data key="d2">параметр режима термомеханической обработки</data>
      <data key="d3" />
      <data key="d4">по режимам с деформацией: 2 — по режиму 2 с температурой окончания деформации при 800°C и 3 — по режиму 3 с температурой окончания деформации при 740 °C.</data>
    </node>
    <node id="N665134d3fa7d0562">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритное зерно</data>
      <data key="d2">микрокристаллическая структура стали</data>
      <data key="d3">зерно феррита</data>
      <data key="d4">зерно в недеформированных образцах</data>
    </node>
    <node id="Nf2816cc514c24d3d">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">деформированный нерекристаллизованный аустенит</data>
      <data key="d2">состояние материала после деформации без рекристаллизации</data>
      <data key="d3" />
      <data key="d4">деформированном нерекристаллизованном аустените</data>
    </node>
    <node id="Nd210d21720181682">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">деформация в γ+α-области</data>
      <data key="d2">процесс пластической деформации в двухфазной области</data>
      <data key="d3" />
      <data key="d4">в деформированных в γ+α—области образцах формируется наиболее мелкодисперсная структура</data>
    </node>
    <node id="N005948bb9758eaf0">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">замедленное охлаждение</data>
      <data key="d2">процесс медленного снижения температуры в штабеле</data>
      <data key="d3" />
      <data key="d4">Окончательным этапом термомеханической обработки стали было замедленное охлаждение листов в штабеле в интервале температур ~400-100 °C.</data>
    </node>
    <node id="Nb372414ce0887a57">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">прочностные свойства</data>
      <data key="d2">характеристика сопротивления материала деформации</data>
      <data key="d3" />
      <data key="d4">при понижении $T_{kl}$ в однофазной аустенитной области (выше 800 °C) прочностные свойства изменяются незначительно</data>
    </node>
    <node id="N1f99a4d5be0b29b0">
      <data key="d0">ХИМИЧЕСКИЙ_ЭЛЕМЕНТ</data>
      <data key="d1">Мо</data>
      <data key="d2">химический элемент молибден</data>
      <data key="d3">Mo</data>
      <data key="d4" />
    </node>
    <node id="Ne87d998afcd667a2">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">физический предел текучести</data>
      <data key="d2">механическое свойство материала</data>
      <data key="d3">предел текучести</data>
      <data key="d4" />
    </node>
    <node id="N0e7426ff62b6a3ca">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">α-фаза</data>
      <data key="d2">кристаллическая фаза ферритная</data>
      <data key="d3">альфа фаза</data>
      <data key="d4" />
    </node>
    <node id="N4a46921a968bd9b2">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура испытания</data>
      <data key="d2">параметр условия испытания</data>
      <data key="d3">+20 °C</data>
      <data key="d4" />
    </node>
    <node id="Nd78bbaa04388052c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">наклеп</data>
      <data key="d2">усиление материала за счет пластической деформации</data>
      <data key="d3" />
      <data key="d4">наклепа феррита, образующегося при прокатке листов в межкритическом интервале температур</data>
    </node>
    <node id="N23c09b9f34644292">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">аустенитное_зерно</data>
      <data key="d2">структурный элемент стали, размер которого изменяется при нагреве и деформации</data>
      <data key="d3" />
      <data key="d4">измельчение аустенитного зерна</data>
    </node>
    <node id="N41775b1efb94b783">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-бейнитная смесь</data>
      <data key="d2">микроструктура стали 05Г2МФБ после завершения деформации и охлаждения</data>
      <data key="d3" />
      <data key="d4">микроструктура стали 05Г2МФБ представляет собой ферритно-бейнитную смесь с включениями высокоуглеродистого мартенсита</data>
    </node>
    <node id="Nf5f68ccffc31c443">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">замедленное_охлаждение</data>
      <data key="d2">режим охлаждения листов в стопе</data>
      <data key="d3" />
      <data key="d4">Затем листы замедленно охлаждали в стопе</data>
    </node>
    <node id="N57a5a9a17ef6154e">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура отпуска</data>
      <data key="d2">параметр термической обработки</data>
      <data key="d3" />
      <data key="d4">температура отпуска на механические свойства</data>
    </node>
    <node id="N66367c809f69bc69">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">механические_свойства</data>
      <data key="d2">характеристики материала</data>
      <data key="d3">механические свойства</data>
      <data key="d4">Влияние температуры отпуска на механические свойства сталей 05Г2МФБ (а) и 10Г2ФБ (б).</data>
    </node>
    <node id="N7718c2ddcebba4e2">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">повторный_нагрев</data>
      <data key="d2">термическая обработка</data>
      <data key="d3">повторный нагрев</data>
      <data key="d4">Представляло интерес исследовать влияние повторного нагрева в межкритическую область температур</data>
    </node>
    <node id="N5e716764e9773d0f">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">межкритическая_область</data>
      <data key="d2">диапазон температур</data>
      <data key="d3">межкритическая область</data>
      <data key="d4">нагревали до 800 °C и после выдержки 2 мин/мм охлаждали на спокойном воздухе. Для обеих сталей после такой обработке наблюдалось падение предела текучести</data>
    </node>
    <node id="N3a479595ff1d9079">
