    <node id="N7e8f551dfb155c22">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">термомеханическая контролируемая прокатка</data>
      <data key="d2">технология обработки стали для получения требуемой структуры</data>
      <data key="d3">ТМКП</data>
      <data key="d4">прокатанных с применением термомеханической контролируемой прокатки</data>
    </node>
    <node id="Nc445a92b9c43dc87">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">сталь ферритно-бейнитного класса</data>
      <data key="d2">сталь ферритно-бейнитного класса с пониженным содержанием углерода</data>
      <data key="d3" />
      <data key="d4">Целью настоящей работы является установление основных закономерностей формирования структуры и свойств стали ферритно-бейнитного класса</data>
    </node>
    <node id="N60e016d196acae2e">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
