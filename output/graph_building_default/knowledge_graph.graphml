    </node>
    <node id="N0344033be588ac31">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">расширение</data>
      <data key="d2">механическое свойство материала при растяжении</data>
      <data key="d3" />
      <data key="d4">на кривых напряжение-деформация</data>
    </node>
