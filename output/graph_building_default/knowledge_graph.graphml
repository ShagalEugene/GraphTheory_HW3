      <data key="d2">термическая обработка с последующим контролем параметров</data>
      <data key="d3" />
      <data key="d4">при ТМКП низколегированных сталей</data>
    </node>
    <node id="N76ed05cab0d92c44">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритно-бейнитная структура</data>
      <data key="d2">структура стали состоящая из феррита и бейнита</data>
      <data key="d3" />
      <data key="d4">переходу от ферритно-перлитной структуры к ферритно-бейнитной</data>
    </node>
    <node id="N130fa4a40ae13206">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">термомеханическая обработка</data>
      <data key="d2">процесс обработки включающий деформацию и нагрев</data>
      <data key="d3" />
      <data key="d4">проведения термомеханической обработки с завершением деформации в двухфазной γ+α-области</data>
    </node>
    <node id="N098660002759b88b">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
