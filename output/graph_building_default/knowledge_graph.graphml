      <data key="d3">X70</data>
      <data key="d4" />
    </node>
    <node id="N6123be18e61b49a1">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура нормализации</data>
      <data key="d2">режим термической обработки</data>
      <data key="d3" />
      <data key="d4">при температуре нормализации</data>
    </node>
    <edge source="N6740ed138d88ff0a" target="N2ae32a4d1637fd9c">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">необходимость повышения эффективности и надежности транспортировки газа приводит к росту рабочих пар</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="N583a885ca389d360">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">еристиками вязкости, сопротивления хрупкому разрушению и свариваемости</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="N4b16f1a2e6e14965">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">еристиками вязкости, сопротивления хрупкому разрушению и свариваемости</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="Nb295aeba3d81e31f">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">в низкоуглеродистых сталях увеличение прокаливаемости приводит к повышению прочности и вязкости</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="Na364e8ae16874178">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">высокоуглеродистый верхний бейнит, негативно влияющий на вязкость стали</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="Nb18700665fec05e7">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">само по себе дисперсионное упрочнение сопровождается снижением сопротивления хрупкому разрушению</data>
    </edge>
    <edge source="N3afb0cb0e62b1cf7" target="N1334d68e5bdb8df6">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">благодаря чему одновременно возрастают прочность и низкотемпературная вязкость</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N7e8f551dfb155c22">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">По уровню механических свойств опытные листы после контролируемой прокатки и дополнительного отпуска</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N36a3ff3b75c222be">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">использование стали категории прочности К65 (X80) взамен стали с меньшим уровнем прочности</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N583a885ca389d360">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">возрастают требования к стали в отношении прочности и сопротивления хрупкому разрушению</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N4b6c91344b544655">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">При увеличении рабочего давления, возрастают требования к ударной вязкости основного металла труб</data>
    </edge>
    <edge source="N6e611784012cc17c" target="Nbc3a9b2e35bd1298">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">требования к ударной вязкости основного металла труб, определяемой на образцах Шарпи</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N101bafe8db2dcf40">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">низкотемпературная контролируемая прокатка является наиболее приемлемой для производства высокопрочн</data>
    </edge>
    <edge source="N6e611784012cc17c" target="Nd45fe940fe243f31">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">влияния трубного передела на механические свойства листов из стали ферритно-бейнитного класса</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N6a73651f6d123521">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">листов для труб большого диаметра категории прочности К65</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N60e016d196acae2e">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">для производства в условиях комбината «Азовсталь» листов для газопроводных труб большого диаметра ка</data>
    </edge>
    <edge source="N6e611784012cc17c" target="N4968f8b6895cf638">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">По уровню механических свойств опытные листы после контролируемой прокатки и дополнительного отпуска</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N583a885ca389d360">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">еристиками вязкости, сопротивления хрупкому разрушению и свариваемости</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N1d448e1c1599a387">
      <data key="d5">ТРЕБУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">С применением высокопрочных сталей для изготовления труб большого диаметра вопросы свариваемости при</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N9722bd7d119a4e8c">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">На свариваемость большое влияние оказывает химическим состав сталей</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N0c64cfdc5636b465">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">упрочнение за счет использования низкоуглеродистого бейнита</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N6a73651f6d123521">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">3</data>
      <data key="d7">Оценить свариваемость разработанной стали 05Г2МФБ</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N68500a7a9b406302">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">для описания влияния базового химического состава стали на ее склонность к образованию холодных трещ</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N0edc01d6e2c90b22">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">для описания влияния базового химического состава стали на ее склонность к образованию холодных трещ</data>
    </edge>
    <edge source="N4b16f1a2e6e14965" target="N248d89603cc8477c">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">изучение свариваемости является необходимым требованием при разработке сталей, используемых при изго</data>
    </edge>
    <edge source="N4b6c91344b544655" target="N61d9fe80248073bb">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Сера в спокойных, раскисленных кремнием и алюминием низколегированных сталях с содержанием марганца </data>
    </edge>
    <edge source="N4b6c91344b544655" target="Nebe3fa5306c723b0">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Повышенные температуры вылеживания листов в штабеле выше 500 °C, из-за сегрегации фосфора, могут спо</data>
    </edge>
    <edge source="N4b6c91344b544655" target="N1ae3af2d16fdfee9">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">что выражается в росте ударной вязкости при отрицательных температурах</data>
    </edge>
    <edge source="N4b6c91344b544655" target="N4a46921a968bd9b2">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">При температуре испытания +20 °C она в обеих сталях монотонно падает при снижении температуры оконча</data>
    </edge>
    <edge source="N4b6c91344b544655" target="N9cd566828b0c3acf">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">при испытании металла в области отрицательных температур снижение $T_{кп}$ в аустенитной области при</data>
    </edge>
    <edge source="N4b6c91344b544655" target="Na75c5f3d8496e847">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">Величина допустимых скоростей охлаждения после сварки определяется требованиями по ударной вязкости,</data>
    </edge>
    <edge source="N4b6c91344b544655" target="Nd496d2e9ea89100b">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">3</data>
      <data key="d7">Величина допустимых скоростей охлаждения после сварки определяется требованиями по ударной вязкости,</data>
    </edge>
    <edge source="N4b6c91344b544655" target="N37374cb8f316c7a7">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">что способствует повышению ударной вязкости до 120-130 Дж/см²</data>
    </edge>
    <edge source="N583a885ca389d360" target="N62733e8a7d1b5abf">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">упрочнение стали при микролегировании ниобием сопровождается значительным повышением сопротивления х</data>
    </edge>
    <edge source="N583a885ca389d360" target="N3c83e6a9b984f90c">
      <data key="d5">ИЗМЕРЯЕТСЯ</data>
      <data key="d6">2</data>
      <data key="d7">сопротивление хрупкому разрушению стали</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N1dc445f8ba905353">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">и требует перехода к иному структурному состоянию материала — к сталям с дисперсной ферритно-бейнитн</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N76ed05cab0d92c44">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">за счет перехода от ферритно-перлитной структуры к ферритно-бейнитной</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N98a5ba82785d1b37">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">состояние структуры и поведение механических свойств исследованных сталей ферритно-бейнитного и ферр</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N4d8c806719154a5c">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">Указанную технологию обычно применяют для производства листов, предназначенного для изготовления газ</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="Nd855e5259159ce71">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">Указанную технологию обычно применяют для производства листов, предназначенного для изготовления газ</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="Nd496d2e9ea89100b">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">в стали 10Г2ФБ — ферритно-перлитная</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N749496fe0bb6a690">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">в стали 10Г2ФБ — ферритно-перлитная</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="Nca81fb82507f6016">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Ц — цементит</data>
    </edge>
    <edge source="N4b3a064d4160d850" target="N8ef5ae19a4a13d2d">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">наименьшая хладостойкость металла околошовной зоны отмечается при низких скоростях охлаждения до 2 °</data>
    </edge>
    <edge source="N62733e8a7d1b5abf" target="N057bc3d86b23d627">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">0,054 % Nb</data>
    </edge>
    <edge source="N62733e8a7d1b5abf" target="Na75c5f3d8496e847">
      <data key="d5">УСКОРЯЕТ</data>
      <data key="d6">3</data>
      <data key="d7">при увеличении скорости охлаждения малоперлитной Nb-V-содержащей стали число расщеплений значительно</data>
    </edge>
    <edge source="N62733e8a7d1b5abf" target="N6a73651f6d123521">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">0,080</data>
    </edge>
    <edge source="N62733e8a7d1b5abf" target="N17afbf61f3b6c65c">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">де случаев оптимальным решением является применение комплексного микролегирования (Nb-Ti, Nb-V, Nb-V</data>
    </edge>
    <edge source="N62733e8a7d1b5abf" target="Ncb0798bbd8149ead">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">добавка ниобия до 0,03-0,04% эффективно повышает предел текучести</data>
    </edge>
    <edge source="N5cae1277467e6558" target="N057bc3d86b23d627">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">0,072 % V</data>
    </edge>
    <edge source="N5cae1277467e6558" target="N6a73651f6d123521">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">0,053</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="Ne73c58d83f00d397">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">разработан химический состав и технология термомеханической контролируемой прокатки комплексно микро</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N1ae3af2d16fdfee9">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">3</data>
      <data key="d7">Температура окончания прокатки при проведении ТМКП оказывает определяющее влияние на конечную микрос</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="Ne030a9a356762ee5">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Основная цель ТМКП это контроль параметров технологии с целью создания условий для протекания опреде</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N6a73651f6d123521">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Изучить микроструктуру стали 05Г2МФБ после термомеханической контролируемой прокатки в производствен</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N8d032b6730db75aa">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">Получение мелкозернистой структуры в листе является основной задачей термомеханической контролируемо</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N4e008a2f22a1ae1b">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Измельчение структуры это единственный структурный фактор, способный одновременно значительно упрочн</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N3b9ccbadba40bfd9">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Основной структурной составляющей в обеих сталях является полиэдрический феррит</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N37374cb8f316c7a7">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Кроме феррита в микроструктуре стали 05Г2МФБ наблюдались продукты промежуточного превращения бейнит</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N2100c6994cf3b12e">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">перлитное превращение полностью подавлено</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N8149a74790b55e1e">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">В микроструктуре стали 05Г2МФБ помимо феррита и продуктов промежуточного превращения обнаружены свет</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N00de48b6050488ad">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Микроструктура листов из сравнительной стали 10Г2ФБ ферритно-перлитная, а стали 05Г2МФБ — ферритно-б</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="N6944f830fe7ff31f">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Микроструктура листов из сравнительной стали 10Г2ФБ ферритно-перлитная, а стали 05Г2МФБ — ферритно-б</data>
    </edge>
    <edge source="N7e8f551dfb155c22" target="Nd0de921c1906fd75">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">разработан режим термомеханической контролируемой прокатки, который предусматривает нагрев слябов пр</data>
    </edge>
    <edge source="N830a1e202cbb9bcb" target="Nf9ee47b9fa74e6cf">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">металл должен подвергаться более тщательной десульфурации с целью получения фактических концентраций</data>
    </edge>
    <edge source="Nf9ee47b9fa74e6cf" target="N8a37a4aee7c4fbf7">
      <data key="d5">ТРЕБУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">металл должен подвергаться более тщательной десульфурации с целью получения фактических концентраций</data>
    </edge>
    <edge source="Nf9ee47b9fa74e6cf" target="N491f0ad8892134f6">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">изготавливаемой с применением термомеханической контролируемой прокатки (ТМКП) применительно к услов</data>
    </edge>
    <edge source="Nf9ee47b9fa74e6cf" target="N2dae6f5f04f101d6">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">упрочненной микродобавками карбонитридообразующих элементов и молибдена</data>
    </edge>
    <edge source="N2dae6f5f04f101d6" target="Ne87d998afcd667a2">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">На листах толщиной 24,9 мм, прошедших дополнительный отпуск при 620 °C, 0,5 ч, определяли физический</data>
    </edge>
    <edge source="N2dae6f5f04f101d6" target="N98a5ba82785d1b37">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Из табл. 6.2 видно, что механические свойства листов толщиной 16,8 мм из опытной стали 05Г2МФБ значи</data>
    </edge>
    <edge source="N2d8ad7bf7f4fa0b5" target="N60e016d196acae2e">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">при ТМКП низколегированных сталей на листовом реверсивном стане 3600</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N9cd566828b0c3acf">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">исследовать процессы формирования структуры в аустенитной области</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N672bab6cd949c2a8">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">на основе моделирования условий горячей пластической деформации, имеющих место при ТМКП низколегиров</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Naf1c78c91107a7e3">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">состояние структуры и поведение механических свойств сталей двух типов: ферритно-бейнитного и феррит</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N21b3fad21ad9bb89">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">состояние структуры и поведение механических свойств сталей двух типов: ферритно-бейнитного и феррит</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Nf261537ed45f2727">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">упрочнение металла в результате формирования структуры с повышенной плотностью дислокаций и развитой</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N253da0697a02dddc">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">упрочнение металла в результате формирования структуры с повышенной плотностью дислокаций и развитой</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N1334d68e5bdb8df6">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">измельчение зерна, за счет динамического γ→α-превращения из нерекристаллизованного аустенита с больш</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Ncb0798bbd8149ead">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Такой режим контролируемой прокатки одновременно позволяет получить в листе из опытной стали 05Г2МФБ</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Na94ab0fb79cd8a04">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">в результате статической рекристаллизации происходит значительное измельчение аустенитного зерна</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N41775b1efb94b783">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">микроструктура стали 05Г2МФБ представляет собой ферритно-бейнитную смесь с включениями высокоуглерод</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N6a73651f6d123521">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Механические свойства листов толщиной 16,8 и 18,7 мм из сталей 05Г2МФБ и 10Г2ФБ после ТМКП*</data>
    </edge>
    <edge source="N60e016d196acae2e" target="Nf5f68ccffc31c443">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Затем листы замедленно охлаждали в стопе в интервале 500 – 100 °C.</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N2d61f9512c007330">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">Окончательную прокатку листов начинали в нижней части аустенитной γ-области</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N6e82a3d58edaa270">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">завершали в двухфазной γ+α-области при температурах 700-670 °C</data>
    </edge>
    <edge source="N60e016d196acae2e" target="N8ef5ae19a4a13d2d">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Механические свойства листов толщиной 16,8 и 18,7 мм из сталей 05Г2МФБ и 10Г2ФБ после ТМКП*</data>
    </edge>
    <edge source="N9cd566828b0c3acf" target="N1ae3af2d16fdfee9">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">при понижении $T_{kl}$ в однофазной аустенитной области (выше 800 °C) прочностные свойства изменяютс</data>
    </edge>
    <edge source="N9cd566828b0c3acf" target="N7b7acbce8afb6c06">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">После завершения деформации листы ускоренно охлаждали на установке ускоренного охлаждения до темпера</data>
    </edge>
    <edge source="N6e82a3d58edaa270" target="N7b7acbce8afb6c06">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">После завершения деформации листы ускоренно охлаждали на установке ускоренного охлаждения до темпера</data>
    </edge>
    <edge source="N6e82a3d58edaa270" target="N005948bb9758eaf0">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">После этого листы укладывали в штабеле при температуре не ниже 400 °C для замедленного охлаждения до</data>
    </edge>
    <edge source="Naf1c78c91107a7e3" target="N4d41ffba091453af">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">C-Mn-Mo-Nb-V-сталь относится к ферритно-бейнитному класс</data>
    </edge>
    <edge source="N98a5ba82785d1b37" target="N76ed05cab0d92c44">
      <data key="d5">ВЛИЯЕТ_НА</data>
      <data key="d6">2</data>
      <data key="d7">состояние структуры и поведение механических свойств исследованных сталей ферритно-бейнитного и ферр</data>
    </edge>
    <edge source="N98a5ba82785d1b37" target="N6a73651f6d123521">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Из табл. 6.2 видно, что механические свойства листов толщиной 16,8 мм из опытной стали 05Г2МФБ значи</data>
    </edge>
    <edge source="N98a5ba82785d1b37" target="N8ef5ae19a4a13d2d">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">Из табл. 6.2 видно, что механические свойства листов толщиной 16,8 мм из опытной стали 05Г2МФБ значи</data>
    </edge>
    <edge source="N76ed05cab0d92c44" target="N130fa4a40ae13206">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">обеспечивающей формирование мелкодисперсной структуры, упрочненной микродобавками карбонитридообразу</data>
    </edge>
    <edge source="N76ed05cab0d92c44" target="Ne73c58d83f00d397">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">3</data>
      <data key="d7">в опытной стали 05Г2МФБ формируется ферритно-бейнитная структура</data>
    </edge>
    <edge source="N76ed05cab0d92c44" target="N749496fe0bb6a690">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">2</data>
      <data key="d7">в опытной стали 05Г2МФБ формируется ферритно-бейнитная структура</data>
    </edge>
    <edge source="Na3278ede3011662f" target="Nd210d21720181682">
      <data key="d5">ФОРМИРУЕТ</data>
      <data key="d6">2</data>
      <data key="d7">в деформированных в γ+α—области образцах формируется наиболее мелкодисперсная структура</data>
    </edge>
    <edge source="N2128a90b42bef993" target="N6a73651f6d123521">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">0,22</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nd496d2e9ea89100b">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">текучести на диаграмме растяжения сравнительной стали 10Г2ФБ была почти в три раза больше, по сравне</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N0529e235e5642765">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">снижение содержания углерода от 0,10 % в стали 10Г2ФБ до 0,06 % в стали 05Г2МФБ расширяет от 70 до 1</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N85d199258da58629">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">опытная, низкоуглеродистая C-Mn-Mo-Nb-V-сталь, обладая при сварке высокой хладостойкостью околошовно</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N2100c6994cf3b12e">
      <data key="d5">УХУДШАЕТ</data>
      <data key="d6">3</data>
      <data key="d7">перлитная область отсутствует вплоть до весьма низкой скорости охлаждения — 0,1 °C/c</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N88bec102cfadfef1">
      <data key="d5">ПРЕВРАЩАЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">опытная сталь с системой легирования C-Mn-Mo-Nb-V относится к ферритно-бейнитному классу</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N41775b1efb94b783">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">микроструктура стали 05Г2МФБ представляет собой ферритно-бейнитную смесь с включениями высокоуглерод</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N4968f8b6895cf638">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">Исчезновение в структуре стали 05Г2МФБ после отпуска от температуры 650 °C высокоуглеродистого марте</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N8149a74790b55e1e">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">Структура стали 05Г2МФБ претерпевает существенные изменения после отпуска при исследованных температ</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N37374cb8f316c7a7">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">внутри бейнита осталась высокая плотность дислокаций, хаотично распределенных в объеме, что свидетел</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nca81fb82507f6016">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">Лишь цементитные пластинки в бейните утолщаются и отчасти коагулируют</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nef4aa77cfcea505a">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">2</data>
      <data key="d7">мартенситно-аустенитными (МА) участками</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nd4839efe6e4ae57e">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">для опытной стали 05Г2МФБ, автоматическая сварка под слоем флюса, ручная дуговая и газоэлектрическая</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nfc141044bda55ad1">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">для опытной стали 05Г2МФБ, автоматическая сварка под слоем флюса, ручная дуговая и газоэлектрическая</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="N54925b941b5003a4">
      <data key="d5">ПРИМЕНЯЕТСЯ_В</data>
      <data key="d6">3</data>
      <data key="d7">для опытной стали 05Г2МФБ, автоматическая сварка под слоем флюса, ручная дуговая и газоэлектрическая</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Nc2960ed3a3461787">
      <data key="d5">СОДЕРЖИТ</data>
      <data key="d6">3</data>
      <data key="d7">Для примера в табл. 6.1. приведены типичные температурно-деформационные параметры в окончательной ст</data>
    </edge>
    <edge source="Ne73c58d83f00d397" target="Ncb0798bbd8149ead">
      <data key="d5">УЛУЧШАЕТ</data>
      <data key="d6">2</data>
      <data key="d7">существенного повышения прочностных свойств (в частности, предела текучести на 70 Н/мм²)</data>
    </edge>
    <edge source="N6a73651f6d123521" target="Ne8990b213519fe31">
