    </node>
    <node id="Ne30300b371a17b0e">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">микрохолодильники</data>
      <data key="d2">вещества для снижения температуры расплава</data>
      <data key="d3" />
      <data key="d4">введение в расплав микро- и макрохолодильников</data>
    </node>
    <node id="Ne2da074cb64c04ba">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">макрохолодильники</data>
      <data key="d2">вещества для снижения температуры расплава</data>
      <data key="d3" />
      <data key="d4">введение в расплав микро- и макрохолодильников</data>
    </node>
    <node id="N95c68fb7ba849aa8">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">мягкое обжатие</data>
      <data key="d2">процесс пластической деформации заготовки</data>
      <data key="d3" />
      <data key="d4">«мягкое» обжатие</data>
    </node>
    <node id="N5a3ac1f9148a3501">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">тепломассоперенос</data>
      <data key="d2">физический процесс переноса тепла и массы в металле</data>
      <data key="d3" />
      <data key="d4">Все эти процессы в той или иной степени влияют на тепломассоперенос</data>
    </node>
    <node id="Nf1cfb60bd7b801a5">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">химическая неоднородность</data>
      <data key="d2">неравномерное распределение химических элементов в металле</data>
      <data key="d3" />
      <data key="d4">уменьшают химическую неоднородность металла</data>
    </node>
    <node id="N610252e4c5918cc7">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">первичное зерно макроструктуры</data>
      <data key="d2">начальная кристаллическая структура металла</data>
      <data key="d3" />
      <data key="d4">измельчают первичное зерно макроструктуры</data>
    </node>
    <node id="N1dfa09024874feb7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">вакуумирование жидкой стали</data>
      <data key="d2">метод внепечной обработки для снижения содержания газов в металле</data>
      <data key="d3" />
      <data key="d4">При обработке жидкого металла вакуумом не только уменьшается содержание растворенных газов кислорода, азота, водорода и оксидных неметаллических включений</data>
    </node>
    <node id="Nf8c77b6fbc3d2aba">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">оксидные неметаллические включения</data>
      <data key="d2">нежелательные примеси в стали</data>
      <data key="d3" />
      <data key="d4">При обработке жидкого металла вакуумом не только уменьшается содержание растворенных газов кислорода, азота, водорода и оксидных неметаллических включений</data>
    </node>
    <node id="N005948bb9758eaf0">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">замедленное охлаждение</data>
      <data key="d2">режим охлаждения материала</data>
      <data key="d3" />
      <data key="d4">в замедленном охлаждении происходят процессы</data>
    </node>
    <node id="Nfe0ec4e259df15a5">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">снижение структурных напряжений</data>
      <data key="d2">уменьшение внутренних напряжений в металле</data>
      <data key="d3" />
      <data key="d4">происходят процессы: ... и снижение структурных напряжений</data>
    </node>
    <node id="N68f90570360d943f">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">сплошность металла</data>
      <data key="d2">характеристика непрерывности материала</data>
      <data key="d3" />
      <data key="d4">повышающие сплошность металла</data>
    </node>
    <node id="Nafcfcb9b52bc17d4">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">ультразвуковой контроль</data>
      <data key="d2">метод неразрушающего контроля</data>
      <data key="d3" />
      <data key="d4">по результатам ультразвукового контроля</data>
    </node>
    <node id="Nc3151d20640be8ca">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">растворимость ниобия</data>
      <data key="d2">параметр, характеризующий способность растворителя удерживать ниобий</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N08aad604e5fc404c">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рекристаллизация аустенита</data>
      <data key="d2">процесс рекристаллизации структуры горячедеформированного аустенита</data>
      <data key="d3" />
      <data key="d4">замедлять процессы восстановления и рекристаллизации горячедеформированного аустенита</data>
    </node>
    <node id="N4f605111547a2bb9">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">дислокация</data>
      <data key="d2">линия дефекта кристаллической решетки</data>
      <data key="d3" />
      <data key="d4">уменьшение количества подвижных, незакрепленных дислокаций</data>
    </node>
    <node id="Na94ab0fb79cd8a04">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">статическая рекристаллизация</data>
      <data key="d2">восстановление структуры материала между проходами деформации</data>
      <data key="d3" />
      <data key="d4">Для статической рекристаллизации требуется критическая степень деформации</data>
    </node>
    <node id="N006a507350e46508">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">собирательная рекристаллизация</data>
      <data key="d2">процесс роста зерна аустенита при высоких температурах</data>
      <data key="d3" />
      <data key="d4">собирательная рекристаллизация</data>
    </node>
    <node id="N213dbc3e9f00e1fd">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитриды ванадия</data>
      <data key="d2">фазы сложного состава с кубической гранецентрированной решеткой</data>
      <data key="d3" />
      <data key="d4">и карбонитриды ванадия имеют кубическую гранецентрированную решетку</data>
    </node>
    <node id="Ne4f499e737f785e2">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">избыточные фазы</data>
      <data key="d2">фазы сложного состава с несколькими карбидообразующими элементами</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N5f66e598ee6d16c7">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">карбонитриды ниобия</data>
      <data key="d2">выделения второй фазы в аустените</data>
      <data key="d3" />
      <data key="d4">KCV</data>
    </node>
    <node id="N0f0095e06fb4ee86">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">деформированная микроструктура</data>
      <data key="d2">удлиненная структура с большим количеством дефектов кристаллической решетки</data>
      <data key="d3" />
      <data key="d4">ра полного торможения рекристаллизации) имеет удлиненную деформированную микроструктуру с большим количеством несовершенств кристаллической решетки</data>
    </node>
    <node id="Nc2af3d7c599dfe37">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">смешанная структура</data>
      <data key="d2">структура с разной плотностью дефектов кристаллической решетки</data>
      <data key="d3" />
      <data key="d4">Такая смешанная структура, с разной плотностью дефектов кристаллической решетки, приводит к значительному увеличению потенциальных мест для зарождения избыточных фаз</data>
    </node>
    <node id="N91c0f0df23264709">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">избыточная фаза</data>
      <data key="d2">вторичная фаза, выделяющаяся в стали</data>
      <data key="d3" />
      <data key="d4">Такая смешанная структура, с разной плотностью дефектов кристаллической решетки, приводит к значительному увеличению потенциальных мест для зарождения избыточных фаз</data>
    </node>
    <node id="N650151cda5f883c4">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">выделения ниобия</data>
      <data key="d2">вторичные фазы ниобия размером 3-7 нм</data>
      <data key="d3" />
      <data key="d4">В результате этого в интервале температур $T_{5}$ — $T_{95}$ происходит интенсивное выделение вторичных фаз ниобия размером 3-7 нм, которые окончательно подавляют рекристаллизацию аустенита</data>
    </node>
    <node id="Nd81632c065924018">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">Sv</data>
      <data key="d2">параметр удельной эффективной поверхности раздела границ</data>
      <data key="d3" />
      <data key="d4">Андервуд, Козасу и др. ввели понятие удельной эффективной поверхности (Sv)</data>
    </node>
    <node id="N665134d3fa7d0562">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ферритное зерно</data>
      <data key="d2">структурный элемент ферритной фазы после полиморфного превращения</data>
      <data key="d3" />
      <data key="d4">чем больше величина Sv, тем меньше размер ферритного зерна</data>
    </node>
    <node id="Ndb6520633928733b">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">размер ферритного зерна</data>
      <data key="d2">характеристика размера кристаллической решётки феррита</data>
      <data key="d3" />
      <data key="d4">влияние на размер аустенитного и ферритного зерна</data>
    </node>
    <node id="N5475ab6898528e2d">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">полиморфное превращение</data>
      <data key="d2">процесс изменения фазового состояния материала при охлаждении</data>
      <data key="d3" />
      <data key="d4">γ→α-превращение</data>
    </node>
    <node id="N92e3700572dc716f">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">размер зерна аустенита</data>
      <data key="d2">характеристика размера кристаллической решётки аустенита</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Na166388fca40a202">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">твердый раствор</data>
      <data key="d2">однородное распределение легирующих элементов в кристаллической решетке</data>
      <data key="d3" />
      <data key="d4">твердый раствор</data>
    </node>
    <node id="Na9ec871f4328db99">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура начала превращения</data>
      <data key="d2">характеристика фазового перехода</data>
      <data key="d3" />
      <data key="d4">нижняя температура начала превращения</data>
    </node>
    <node id="Nf7212232f0fdefc4">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">игольчатый феррит</data>
      <data key="d2">микроконструкция, образующаяся при низкотемпературном распаде аустенита</data>
      <data key="d3" />
      <data key="d4">продукты низкотемпературного превращения, такие, как игольчатый феррит</data>
    </node>
    <node id="N3c6958eaea94e14e">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">ти аустенита</data>
      <data key="d2">фаза твердого раствора с ГЦК решеткой</data>
      <data key="d3" />
      <data key="d4">ти аустенита способствует образованию большего количества продуктов низкотемпературного превращения</data>
    </node>
    <node id="N7e9e5366e35e18b9">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">высокоуглеродистая сталь</data>
      <data key="d2">сталь с повышенным содержанием углерода</data>
      <data key="d3" />
      <data key="d4">в сталях с повышенным содержанием углерода, при увеличение прокаливаемости, образуется высокоуглеродистый верхний бейнит</data>
    </node>
    <node id="N33a64f72e3f8937a">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">прокаливаемость</data>
      <data key="d2">характеристика скорости закалки стали</data>
      <data key="d3" />
      <data key="d4">увеличение прокаливаемости приводит к повышению прочности и вязкости</data>
    </node>
    <node id="N74c2aeef9a76fc2b">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">низкоуглеродистый игольчатый бейнит</data>
      <data key="d2">микроконструкция бейнита с низким содержанием углерода</data>
      <data key="d3" />
      <data key="d4">в результате образования низкоуглеродистого игольчатого бейнита</data>
    </node>
    <node id="Nb9a957fe9d9f9c6f">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">высокоуглеродистый верхний бейнит</data>
      <data key="d2">микроконструкция бейнита с высоким содержанием углерода</data>
      <data key="d3" />
      <data key="d4">образуется высокоуглеродистый верхний бейнит, негативно влияющий на вязкость стали</data>
    </node>
    <node id="Nc9334c059ca78ab0">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">низкоуглеродистые стали</data>
      <data key="d2">класс сталей с низким содержанием углерода для повышения вязкости</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Nf4c9e084a17abda2">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">ферритно-бейнитные стали</data>
      <data key="d2">класс сталей с ферритно-бейнитной структурой</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Nb0e25985cbc17cdc">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">ферритно-перлитные стали</data>
      <data key="d2">класс сталей с ферритно-перлитной структурой</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="N37374cb8f316c7a7">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">бейнит</data>
      <data key="d2">микрокристаллическая структура стали с высокой плотностью дислокаций</data>
      <data key="d3">B_H; бейнитная составляющая; фазы</data>
      <data key="d4">средний размер бейнитных пластин — менее 1 мкм</data>
    </node>
    <node id="Nba0e557a41c670b5">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">дисперсионное твердение</data>
      <data key="d2">способ упрочнения материала за счёт выделения дисперсных частиц</data>
      <data key="d3" />
      <data key="d4">эффективны для дисперсионного твердения частицы размером примерно от 1 до 2 нм</data>
    </node>
    <node id="N3fa66b968fa25e7c">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">частица</data>
      <data key="d2">дисперсное выделение, когерентное с матрицей или некогерентное</data>
      <data key="d3" />
      <data key="d4">Очень эффективны для дисперсионного твердения частицы размером примерно от 1 до 2 нм</data>
    </node>
    <node id="N7213a4635eaa5fb0">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">γ→α-превращение</data>
      <data key="d2">фазовое превращение аустенита в феррит</data>
      <data key="d3" />
      <data key="d4">образуются в процессе или после завершения γ→α-превращения</data>
    </node>
    <node id="N6140d1f911b81844">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">зерно</data>
      <data key="d2">структурный элемент ферритной или аустенитной матрицы</data>
      <data key="d3">зерен; кристаллит</data>
      <data key="d4">зерно аустенита</data>
    </node>
    <node id="Nab02f0ceb35a0c43">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">твердение</data>
      <data key="d2">дисперсионное твердение материала</data>
      <data key="d3" />
      <data key="d4">твердение</data>
    </node>
    <node id="N92d7bca0f9771ba2">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">зерно аустенита</data>
      <data key="d2">структурное состояние твердого раствора перед прокаткой</data>
      <data key="d3" />
      <data key="d4">перед проведением предварительной прокатки желательно, чтобы зерно аустенита было достаточно мелким</data>
    </node>
    <node id="N603e1a84e5903775">
      <data key="d0">СОЕДИНЕНИЕ</data>
      <data key="d1">нитрид титана</data>
      <data key="d2">соединение титана с азотом</data>
      <data key="d3" />
      <data key="d4">TiN</data>
    </node>
    <node id="N5952bc0f620ab5b7">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рост зерна</data>
      <data key="d2">процесс увеличения размера зерен аустенита</data>
      <data key="d3" />
      <data key="d4" />
    </node>
    <node id="Ndb6833f7fc6a4b60">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">предварительная прокатка</data>
      <data key="d2">процесс деформации металла перед основным формованием</data>
      <data key="d3" />
      <data key="d4">Управление этими процессами на стадии предварительной прокатки металла приводит к эффективному измельчению зерна за счет многократной рекристаллизации после каждого прохода</data>
    </node>
    <node id="N1334d68e5bdb8df6">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">измельчение зерна</data>
      <data key="d2">состояние материала с мелким размером кристаллов</data>
      <data key="d3" />
      <data key="d4">эффективному измельчению зерна за счет многократной рекристаллизации после каждого прохода</data>
    </node>
    <node id="Ne07c607bfddffb2f">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">междеформационные паузы</data>
      <data key="d2">время между этапами деформации металла</data>
      <data key="d3" />
      <data key="d4">при горячей пластической деформации или во время междеформационных пауз могут происходить процессы разупрочнения</data>
    </node>
    <node id="Nde4a9b6905c7869f">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">разупрочнение</data>
      <data key="d2">снижение прочности материала при сохранении пластичности</data>
      <data key="d3" />
      <data key="d4">состояние деформированного металла является термодинамически неустойчивым, в результате этого при горячей пластической деформации или во время междеформационных пауз могут происходить процессы разупрочнения</data>
    </node>
    <node id="Na016c755fdc3570f">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">горячедеформированный аустенит</data>
      <data key="d2">фаза металла с высокой температурой и деформированной структурой</data>
      <data key="d3" />
      <data key="d4">На промышленных станах в зависимости от степени и температуры деформации разупрочнение горячедеформированного аустенита осуществляется за счет протекания динамических и статических процессов возврата и рекристаллизации</data>
    </node>
    <node id="N61fc0e51671e0fb6">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">разупрочнение аустенита</data>
      <data key="d2">процесс снижения прочности горячедеформированного материала</data>
      <data key="d3" />
      <data key="d4">нах в зависимости от степени и температуры деформации разупрочнение горячедеформированного аустенита</data>
    </node>
    <node id="Naea38cd53af72e2d">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">статический возврат</data>
      <data key="d2">процесс уменьшения плотности дислокаций без изменения размера зерен</data>
      <data key="d3" />
      <data key="d4">разупрочнение аустенита вызывается только статическим возвратом, при котором уменьшается плотность дислокаций</data>
    </node>
    <node id="N8f99d2ca7897e872">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура рекристаллизации</data>
      <data key="d2">параметр, определяемый по эмпирической формуле</data>
      <data key="d3" />
      <data key="d4">Температура рекристаллизации горячедеформированного аустенита зависит от параметров деформации и химического состава стали</data>
    </node>
    <node id="Nd0de921c1906fd75">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">нагрев</data>
      <data key="d2">термическая обработка для подготовки к деформации</data>
      <data key="d3" />
      <data key="d4">Нагрев образца до температуры 950 °C</data>
    </node>
    <node id="N6acf8c850aae02fd">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">рекристаллизация</data>
      <data key="d2">процесс восстановления структуры</data>
      <data key="d3">собирательная рекристаллизация</data>
      <data key="d4">при 960 °C интенсивно протекает не только первичная рекристаллизация, но и собирательная рекристаллизация</data>
    </node>
    <node id="Nb49fd6c4453fd345">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">Температура окончания прокатки</data>
      <data key="d2">параметр технологического режима завершения процесса деформации</data>
      <data key="d3" />
      <data key="d4">Температура окончания прокатки при проведении ТМКП оказывает определяющее влияние на конечную микроструктуру</data>
    </node>
    <node id="N6e3a950989059e4f">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">структурообразование</data>
      <data key="d2">процесс изменения внутренней структуры материала</data>
      <data key="d3" />
      <data key="d4">Анализ процессов, протекающих при горячей пластической деформации, показал, что эффективное и стабильное воздействие на структуру стали определяется наличием и величиной трех температурных интервалов, ограниченных критическими точками превращения и температурами рекристаллизации деформированного аустенита. Такой подход приводит к трем схемам ТМКП</data>
    </node>
    <node id="N5c80d77d2b9419ef">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Рекристаллизационная контролируемая прокатка</data>
      <data key="d2">вид термомеханической контролируемой прокатки</data>
      <data key="d3" />
      <data key="d4">Рекристаллизационная контролируемая прокатка. Вся деформация проводится выше температуры рекристаллизации в аустенитной области (I стадия &gt;T$_{p}$)</data>
    </node>
    <node id="Nb01638e6798f76c6">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Высокотемпературная контролируемая прокатка</data>
      <data key="d2">вид термомеханической контролируемой прокатки</data>
      <data key="d3" />
      <data key="d4">Высокотемпературная контролируемая прокатка. Предварительная деформация в рекристаллизованной области (I стадия &gt;T$_{p}$), окончательная прокатка в нерекристаллизованной области (II стадия —T$_{p}$.....Ar$_{3}$)</data>
    </node>
    <node id="N19fbeafeb995a722">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">атурная контролируемая прокатка</data>
      <data key="d2">процесс деформации стали с контролем температуры</data>
      <data key="d3">атурная</data>
      <data key="d4">Предварительная деформация в рекристаллизованной области (I стадия &gt;T$_{p}$), окончательная прокатка в нерекристаллизованной области (II стадия —T$_{p}$.....Ar$_{3}$)</data>
    </node>
    <node id="Na8d9cc10d2658adf">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">низкотемпературная контролируемая прокатка</data>
      <data key="d2">процесс деформации стали при температурах ниже точки рекристаллизации</data>
      <data key="d3">низкотемпературная</data>
      <data key="d4">Реализуются все три стадии деформации (I стадия &gt;T$_{p}$, II стадия —T$_{p}$.....Ar$_{3}$, III стадия — Ar$_{3}$.....Ar$_{1}$)</data>
    </node>
    <node id="N682bbefbdf0340ba">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">ректисталлизационная контролируемая прокатка</data>
      <data key="d2">процесс деформации при температурах выше точки рекристаллизации аустенита</data>
      <data key="d3">ректисталлизационная</data>
      <data key="d4">Рекристаллизационную контролируемую прокатку проводят при температурах выше температуры рекристаллизации аустенита</data>
    </node>
    <node id="N5f4a843b2647a155">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">мелкозернистая аустенитная структура</data>
      <data key="d2">структура с мелким размером зерна аустенита</data>
      <data key="d3">мелкозернистая</data>
      <data key="d4">В результате многократной рекристаллизации и деформации в листах формируется мелкозернистая аустенитная структура</data>
    </node>
    <node id="N82ec8e5739ee9b16">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">температура конца прокатки</data>
      <data key="d2">параметр технологического режима процесса прокатки</data>
      <data key="d3" />
      <data key="d4">мпературы конца прокатки</data>
    </node>
    <node id="Na43de5c402a240d5">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">средняя скорость охлаждения</data>
      <data key="d2">параметр теплового режима процесса охлаждения</data>
      <data key="d3" />
      <data key="d4">dT/dt</data>
    </node>
    <node id="Nb3400f5d787c7c1e">
      <data key="d0">ИЗДЕЛИЕ</data>
      <data key="d1">головной конец листа</data>
      <data key="d2">часть прокатного изделия, выходящая из валков</data>
      <data key="d3" />
      <data key="d4">выхода головного конца листа из прокатных валков</data>
    </node>
    <node id="Nd62aa184ca4f7afe">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">высокий комплекс прочностных и пластических свойств</data>
      <data key="d2">характеристика материала, включающая прочность и пластичность</data>
      <data key="d3" />
      <data key="d4">обеспечивая высокий комплекс прочностных и пластических свойств</data>
    </node>
    <node id="N9dfedc654ef481d1">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">окончательная прокатка</data>
      <data key="d2">стадия обработки давлением при температурах ниже температуры рекристаллизации</data>
      <data key="d3" />
      <data key="d4">При окончательной прокатке, которая проводится при температурах ниже температуры рекристаллизации, аустенитное зерно приобретает удлиненную форму</data>
    </node>
    <node id="N0bd2b83772885b44">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">границы</data>
      <data key="d2">места зарождения феррита</data>
      <data key="d3" />
      <data key="d4">х границ, являющихся потенциальными местами зарождения феррита</data>
    </node>
    <node id="Na9c83ed90af01bb7">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">скорость зарождения</data>
      <data key="d2">кинетическая характеристика процесса фазового превращения</data>
      <data key="d3" />
      <data key="d4">высокая скорость его зарождения</data>
    </node>
    <node id="N04840bae3fcb73fb">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">конечная структура</data>
      <data key="d2">микроструктура металла после завершения технологического процесса</data>
      <data key="d3" />
      <data key="d4">измельчение конечной структуры металла</data>
    </node>
    <node id="N53cd96d37b301956">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">толщина подката</data>
      <data key="d2">геометрический параметр заготовки на стадии прокатки</data>
      <data key="d3" />
      <data key="d4">толщина подката для окончательной стадии прокатки</data>
    </node>
    <node id="N5036b4eb63dc75e3">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">конечная толщина листа</data>
      <data key="d2">геометрический параметр готового изделия</data>
      <data key="d3" />
      <data key="d4">конечную толщину листа</data>
    </node>
    <node id="Nee8a02b6b50954b0">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">зародыши α-фазы</data>
      <data key="d2">начальные центры кристаллизации феррита в переохлаждённом аустените</data>
      <data key="d3" />
      <data key="d4">больше зародышей α-фазы в переохлажденном аустените</data>
    </node>
    <node id="N2100c6994cf3b12e">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">перлит</data>
      <data key="d2">феррито-цементитная эвтектоидная смесь, образующаяся при медленном охлаждении</data>
      <data key="d3">фазы</data>
      <data key="d4">игольчатых продуктов распада аустенита взамен перлита</data>
    </node>
    <node id="N2e0bb05ca82a7592">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">Ускоренное охлаждение</data>
      <data key="d2">технологический режим охлаждения металла для получения требуемых свойств</data>
      <data key="d3" />
      <data key="d4">Ускоренное охлаждение впервые было введено на непрерывных широкополосных станах</data>
    </node>
    <node id="N68dc3d5085e85d1d">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">межкритическая область</data>
      <data key="d2">температурный диапазон между Ar3 и Ar1</data>
      <data key="d3" />
      <data key="d4">Понижение температуры прокатки в межкритическую область способствует значительному измельчению структуры готовой стали</data>
    </node>
    <node id="N0e7426ff62b6a3ca">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">α-фаза</data>
      <data key="d2">ферритная фаза</data>
      <data key="d3" />
      <data key="d4">так как в этом случае при наличии большого числа образующихся объемов α-фазы ограничивается скорость роста зерна феррита</data>
    </node>
    <node id="Nca4b6b2be70374de">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">деформация феррита</data>
      <data key="d2">процесс наклепа</data>
      <data key="d3" />
      <data key="d4">При деформации металла в двухфазной γ-α-области могут протекать следующие структурные изменения: ... деформация феррита (наклеп)</data>
    </node>
    <node id="N016cb5eaedda7255">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">остаточный аустенит</data>
      <data key="d2">γ-фаза, остающаяся после прокатки</data>
      <data key="d3" />
      <data key="d4">После завершения деформации происходит превращение остаточного аустенита в феррит, перлит или бейнит</data>
    </node>
    <node id="N253da0697a02dddc">
      <data key="d0">МИКРОСТРУКТУРА</data>
      <data key="d1">субструктура</data>
      <data key="d2">внутренняя структура деформированного металла, сформировавшаяся в результате возврата и полигонизации</data>
      <data key="d3" />
      <data key="d4">развитой субструктуры, сформировавшейся в результате прошедших в них процессов возврата и полигонизации</data>
    </node>
    <node id="Nd116aad9f2fbb4bc">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">производство</data>
      <data key="d2">процесс изготовления металлоизделий</data>
      <data key="d3" />
      <data key="d4">освоения производства листов категории прочности К65</data>
    </node>
    <node id="N91bffa34027b2aac">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">листовая сталь</data>
      <data key="d2">материал, подвергаемый термомеханической обработке</data>
      <data key="d3" />
      <data key="d4">ности производства листов известных систем легирования на уровне прочности К65 по режимам контролируемой прокатки с последующим недостаточно интенсивным охлаждением листов после завершения деформации.</data>
    </node>
    <node id="Ne569b15cd772a42e">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">предварительная деформация</data>
      <data key="d2">стадия процесса прокатки перед окончательной деформацией</data>
      <data key="d3" />
      <data key="d4">Недостаточно изучены процессы формирования аустенитного зерна во время предварительной деформации</data>
    </node>
    <node id="Ne8de3130ea374d55">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">термическая обработка</data>
      <data key="d2">процесс изменения свойств материала нагревом и охлаждением</data>
      <data key="d3" />
      <data key="d4">Практически отсутствуют сведения о влиянии термической обработки на структуру и механические свойства листов, предварительно подвергнутого термомеханической контролируемой прокатке.</data>
    </node>
    <node id="Nd45fe940fe243f31">
      <data key="d0">ТЕХНОЛОГИЧЕСКИЙ_ПРОЦЕСС</data>
      <data key="d1">трубный передел</data>
      <data key="d2">этап производства труб из листов</data>
      <data key="d3" />
      <data key="d4">В виду отсутствия на отечественных трубных заводах опыта изготовления труб большого диаметра из сталей класса прочности К65, нерешенным представляется вопрос, влияния трубного передела на механические свойства листов из стали ферритно-бейнитного класса.</data>
    </node>
