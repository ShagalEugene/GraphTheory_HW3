      <data key="d2">соединение ниобия с азотом</data>
      <data key="d3" />
      <data key="d4">нитрид и карбид ванадия полностью растворяются в аустените</data>
    </node>
    <node id="N6845f8114dc9ea59">
      <data key="d0">МАТЕРИАЛ</data>
      <data key="d1">трубная ниобийсодержащая сталь категории X80</data>
      <data key="d2">марка высокопрочной трубной стали</data>
      <data key="d3">X80</data>
      <data key="d4">современная трубная ниобийсодержащая сталь категории X80</data>
    </node>
