      <data key="d2">процесс изменения формы материала</data>
      <data key="d3" />
      <data key="d4">ой обработки с завершением деформации в двухфазной γ+α-области</data>
    </node>
    <node id="Na3278ede3011662f">
      <data key="d0">МИКРОСТРУКТУРА</data>
