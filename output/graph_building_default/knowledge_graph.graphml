      <data key="d0">СВОЙСТВО</data>
      <data key="d1">механические свойства</data>
      <data key="d2">характеристики материала, определяющие его поведение под нагрузкой</data>
      <data key="d3">свойства</data>
      <data key="d4">механических свойств</data>
    </node>
    <node id="Ne030a9a356762ee5">
      <data key="d0">МИКРОСТРУКТУРА</data>
