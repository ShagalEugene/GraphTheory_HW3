      <data key="d3" />
      <data key="d4">Температурно-деформационные параметры прокатки листов толщиной 24,9 мм из стали 05Г2МФБ</data>
    </node>
    <node id="Nd7b4310010d4f3ae">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">давление</data>
