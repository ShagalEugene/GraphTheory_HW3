      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">пластическая деформация</data>
      <data key="d2">величина пластической деформации при трубном переделе</data>
      <data key="d3" />
      <data key="d4">обычно величина пластической деформации при трубном переделе составляет 2-3 %</data>
    </node>
    <node id="Nefa829e44783938d">
      <data key="d0">СВОЙСТВО</data>
      <data key="d1">эффект Баушингера</data>
      <data key="d2">физико-механическое явление, влияющее на свойства металла</data>
      <data key="d3" />
      <data key="d4">механические свойства, прежде всего предел текучести, оказывается под воздействием эффекта Баушингера</data>
    </node>
    <node id="Ne5872b2b2ba52724">
      <data key="d0">ПАРАМЕТР</data>
      <data key="d1">диаграмма напряжение-деформация</data>
      <data key="d2">график зависимости напряжения от деформации</data>
      <data key="d3" />
      <data key="d4">поведение металла в области малых упруго-пластических деформаций, выражающееся в наличии или отсутствии площадки текучести на диаграмме напряжение-деформация</data>
    </node>
    <node id="N00de48b6050488ad">
